<Window x:Class="EmbedDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EmbedDesk.App.Controls"
        Title="EmbedDesk"
        Icon="Assets/embeddesk.ico"
        Width="1340"
        Height="940"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources><controls:InverseBooleanVisibilityConverter x:Key="FullscreenChromeVisibility" /></Window.Resources>
    <Grid x:Name="ApplicationSurface" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="22,12,22,0" Visibility="{Binding RemoteDebug.IsTerminalFullscreen, Converter={StaticResource FullscreenChromeVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="Assets/embeddesk.ico" Width="26" Height="26" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="EmbedDesk" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="OpenSettings_Click" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" /></Button>
                <Button Style="{StaticResource IconButton}" Click="OpenConfiguration_Click" ToolTip="导入 / 导出配置"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" /></Button>
                <Button x:Name="AboutButton" Style="{StaticResource IconButton}" Click="OpenAbout_Click" ToolTip="关于 EmbedDesk" AutomationProperties.Name="关于 EmbedDesk">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" />
                </Button>
                <Button x:Name="GitHubButton" Style="{StaticResource IconButton}" Click="OpenRepository_Click" ToolTip="在浏览器中打开 EmbedDesk 开源仓库" AutomationProperties.Name="GitHub · EmbedDesk 开源仓库">
                    <!-- Octicons v19.0.0 mark-github-16; MIT, see docs/third-party/octicons-MIT.txt. -->
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OpenLogs_Click" ToolTip="运行日志"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" /></Button>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainWorkspaceTabs" Grid.Row="1" SelectionChanged="MainWorkspaceTabs_SelectionChanged">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid Background="{TemplateBinding Background}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Visibility="{Binding RemoteDebug.IsTerminalFullscreen, Converter={StaticResource FullscreenChromeVisibility}}"><TabPanel IsItemsHost="True" /></Border>
                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
            </Grid></ControlTemplate></TabControl.Template>
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="连接中心" /></StackPanel></TabItem.Header>
                <controls:ConnectionCenterWorkspace DataContext="{Binding Connections}" />
            </TabItem>
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE958;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="调试助手" /></StackPanel></TabItem.Header>
                <controls:DebugAssistantWorkspace x:Name="DebugAssistant" />
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="远程调试" /></StackPanel></TabItem.Header>
                <controls:RemoteDebugWorkspace x:Name="RemoteArea" DataContext="{Binding RemoteDebug}" />
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="网络工具" /></StackPanel></TabItem.Header>
                <controls:NetworkToolsWorkspace />
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="嵌入式工具" /></StackPanel></TabItem.Header>
                <controls:EmbeddedToolsWorkspace />
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Visibility="{Binding RemoteDebug.IsTerminalFullscreen, Converter={StaticResource FullscreenChromeVisibility}}" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,7">
            <TextBlock Text="{Binding ActivityStatus}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
