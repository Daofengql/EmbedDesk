<Window x:Class="EmbedDesk.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 EmbedDesk"
        Icon="Assets/embeddesk.ico"
        Width="520"
        SizeToContent="Height"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/embeddesk.ico" Width="64" Height="64" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="18,2,0,0">
                <TextBlock Text="EmbedDesk" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="嵌入式开发与网络调试工作台" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,0" />
                <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <StackPanel>
                <TextBlock Text="关于软件" FontWeight="SemiBold" />
                <TextBlock Text="EmbedDesk 为 Windows 嵌入式开发者提供串口、Shell、远程调试、网络调试、烧录和常用网络工具，帮助快速定位设备、协议与连接问题。" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" />
                <TextBlock Text="项目坚持优先使用系统 API 和 .NET 内部实现，保持工具轻量、可移植，并在操作系统级功能前明确提示和确认。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="作者" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Row="1" Text="Daofeng · Daofengql" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Text="原创代码采用 GNU GPL-3.0-only，欢迎提交 Issue 和 Pull Request。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="打开 GitHub 仓库" Click="OpenRepository_Click" Style="{StaticResource PrimaryButton}" />
            <Button Content="关闭" Click="Close_Click" Margin="10,0,0,0" MinWidth="76" />
        </StackPanel>
    </Grid>
</Window>
