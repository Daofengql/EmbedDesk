<Window x:Class="EmbedDesk.App.UpnpDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UPnP 发现" Icon="Assets/embeddesk.ico" Width="900" Height="580" MinWidth="760" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="UPnP 发现" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="使用 SSDP 在局域网中发现路由器、Internet Gateway 和其他 UPnP 设备。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="SearchTypeBox"><ComboBoxItem Content="全部设备" /><ComboBoxItem Content="Internet Gateway" /><ComboBoxItem Content="根设备" /></ComboBox><Button Grid.Column="1" Content="发现" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="10,0,8,0" /><Button Grid.Column="2" x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" /></Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Devices}" IsReadOnly="True" CanUserResizeRows="False"><DataGrid.Columns><DataGridTextColumn Header="设备类型" Binding="{Binding Type}" Width="220" /><DataGridTextColumn Header="地址" Binding="{Binding Location}" Width="*" /><DataGridTextColumn Header="服务标识" Binding="{Binding Server}" Width="230" /><DataGridTextColumn Header="响应地址" Binding="{Binding Endpoint}" Width="150" /></DataGrid.Columns></DataGrid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="未开始" Style="{StaticResource MutedText}" /></Grid>
    </Grid>
</Window>
