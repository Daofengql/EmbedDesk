<Window x:Class="EmbedDesk.App.ConnectionProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EmbedDesk.App.Controls"
        Title="远程连接" Icon="Assets/embeddesk.ico" Width="560" SizeToContent="Height" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources><controls:RemoteProtocolLabelConverter x:Key="RemoteProtocolLabel" /><controls:RemoteAuthenticationLabelConverter x:Key="RemoteAuthenticationLabel" /><controls:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibility" /></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="远程连接" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="保存连接配置，双击左侧列表即可打开新标签。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,20" /></StackPanel>
        <ScrollViewer x:Name="ProfileScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,6,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="名称" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" /></Grid>
            <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="140" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="协议" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ProtocolOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Editor.Protocol}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource RemoteProtocolLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="20,0,0,0" Visibility="{Binding IsS3, Converter={StaticResource InverseBooleanVisibility}, RelativeSource={RelativeSource AncestorType=Window}}" /><TextBox x:Name="PortEditor" Grid.Column="3" Text="{Binding Editor.Port, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsS3, Converter={StaticResource InverseBooleanVisibility}, RelativeSource={RelativeSource AncestorType=Window}}" /><TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="S3 使用标准 HTTPS 端口" VerticalAlignment="Center" Margin="20,0,0,0" Visibility="{Binding IsS3, Converter={StaticResource BooleanVisibility}, RelativeSource={RelativeSource AncestorType=Window}}" /></Grid>
            <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Editor.EndpointLabel}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Editor.Host, UpdateSourceTrigger=PropertyChanged}" ToolTip="S3 可留空以使用 AWS 默认端点，或填写兼容服务的 HTTPS URL" /></Grid>
            <Grid Grid.Row="3" Margin="0,0,0,12" Visibility="{Binding HasUsername, Converter={StaticResource BooleanVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="用户名" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Editor.Username, UpdateSourceTrigger=PropertyChanged}" /></Grid>
            <Grid Grid.Row="4" Margin="0,0,0,12" Visibility="{Binding IsSsh, Converter={StaticResource BooleanVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="认证方式" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding AuthenticationOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Editor.AuthenticationMode}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource RemoteAuthenticationLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
            <Grid Grid.Row="5" Margin="0,0,0,12" Visibility="{Binding IsPasswordAuthentication, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="密码" VerticalAlignment="Center" /><PasswordBox Grid.Column="1" x:Name="PasswordEditor" PasswordChanged="PasswordEditor_Changed" /></Grid>
            <Grid Grid.Row="6" Margin="0,0,0,12" Visibility="{Binding IsKeyAuthentication, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="私钥文件" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Editor.KeyPaths}" SelectedItem="{Binding Editor.PrivateKeyPath}" /><Button Grid.Column="2" Margin="8,0,0,0" Click="BrowseKey_Click" ToolTip="选择私钥"><TextBlock Text="选择" /></Button></Grid>
            <Grid Grid.Row="7" Margin="0,0,0,12" Visibility="{Binding IsKeyAuthentication, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="私钥口令" VerticalAlignment="Center" /><PasswordBox Grid.Column="1" x:Name="KeyPassphraseEditor" PasswordChanged="KeyPassphraseEditor_Changed" /></Grid>
            <Grid Grid.Row="4" Margin="0,0,0,12" Visibility="{Binding IsS3, Converter={StaticResource BooleanVisibility}, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="区域" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Editor.S3Region, UpdateSourceTrigger=PropertyChanged}" /></Grid>
            <Grid Grid.Row="5" Margin="0,0,0,12" Visibility="{Binding IsS3, Converter={StaticResource BooleanVisibility}, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="默认桶" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Editor.S3Bucket, UpdateSourceTrigger=PropertyChanged}" /></Grid>
            <Grid Grid.Row="6" Margin="0,0,0,12" Visibility="{Binding IsS3, Converter={StaticResource BooleanVisibility}, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Access Key" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Editor.S3AccessKeyId, UpdateSourceTrigger=PropertyChanged}" /></Grid>
            <Grid Grid.Row="7" Margin="0,0,0,12" Visibility="{Binding IsS3, Converter={StaticResource BooleanVisibility}, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Secret Key" VerticalAlignment="Center" /><PasswordBox Grid.Column="1" x:Name="S3SecretEditor" PasswordChanged="S3SecretEditor_Changed" /></Grid>
            <StackPanel Grid.Row="8"><CheckBox Visibility="{Binding IsSsh, Converter={StaticResource BooleanVisibility}}" x:Name="AcceptHostKey" Content="接受未知主机密钥" IsChecked="{Binding Editor.AcceptUnknownHostKey}" /><CheckBox Visibility="{Binding IsS3, Converter={StaticResource BooleanVisibility}}" Content="将密钥保存到本机 Windows 凭据管理器" IsChecked="{Binding Editor.RememberS3Credentials}" Margin="0,0,0,8" /><Button Visibility="{Binding IsS3, Converter={StaticResource BooleanVisibility}}" Content="清除已保存的 S3 凭据" Click="ClearS3Credential_Click" HorizontalAlignment="Left" Margin="0,0,0,8" /><TextBlock x:Name="AuthenticationHint" Text="{Binding ConnectionHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11" Margin="0,9,0,0" /><TextBlock x:Name="ValidationMessage" Foreground="#F0A4A4" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel>
        </Grid>
        </ScrollViewer>
        <StackPanel x:Name="ActionButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" /><Button Content="保存" Click="Save_Click" Margin="0,0,8,0" /><Button Content="打开" Style="{StaticResource PrimaryButton}" Click="Open_Click" /></StackPanel>
    </Grid>
</Window>
