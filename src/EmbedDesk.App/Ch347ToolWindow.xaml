<Window x:Class="EmbedDesk.App.Ch347ToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CH347T 烧录工具" Icon="Assets/embeddesk.ico"
        Width="960" Height="730" MinWidth="820" MinHeight="650" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CH347T 烧录工具" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="SPI NOR / NAND · 芯片识别、备份、擦除、写入及回读校验" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
            <TextBlock Text="使用 CH347T 标准 HID 模式（1A86:55DC），无需外部程序或厂商 DLL。请使用 3.3V 供电并核对引脚；1.8V 芯片需电平转换。" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,0" x:Name="ConnectionPanel">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="95"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="DeviceBox" DisplayMemberPath="DisplayName" ToolTip="CH347T HID SPI 设备"/>
            <ComboBox x:Name="SpeedBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="SPI 时钟，长飞线建议低速"/>
            <ComboBox x:Name="CsBox" Grid.Column="2" Margin="8,0,0,0" ToolTip="SPI 片选"/>
            <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" Click="Refresh_Click" Margin="8,0,0,0"/>
            <Button x:Name="ConnectButton" Grid.Column="4" Content="连接并识别" Click="Connect_Click" Margin="8,0,0,0"/>
        </Grid>
        <TextBox x:Name="ChipInfoBox" Grid.Row="2" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72" VerticalContentAlignment="Center" Text="支持 W25Q16 / 32 / 64 / 128（EF40xx）与 W25N01GV（EFAA21）。未知芯片不会启用擦写。"/>
        <Grid x:Name="RangePanel" Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="起始地址（十六进制或十进制）" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="OffsetBox" Text="0x0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="备份 / 擦除长度" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="LengthBox" Text="0x1000"/></StackPanel>
            <CheckBox Grid.Column="2" x:Name="RawOobBox" Content="原始 NAND 备份（含 OOB）" IsEnabled="False" VerticalAlignment="Bottom" Margin="16,0,0,8" ToolTip="每页 2048 + 64 字节，关闭 ECC，保留坏块与物理布局。此格式仅用于备份，禁止作为普通 BIN 刷写。"/>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ImagePathBox" IsReadOnly="True" ToolTip="写入只接受不含 OOB 的 BIN；按芯片擦除块边界写入，末尾擦除块会补 FF。"/><Button x:Name="ChooseButton" Grid.Column="1" Content="选择 BIN" Click="Choose_Click" Margin="8,0,0,0"/></Grid>
            <WrapPanel Margin="0,10,0,0" x:Name="ActionPanel">
                <Button x:Name="BackupButton" Content="读取备份" Click="Backup_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="ScanButton" Content="扫描坏块" Click="Scan_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="EraseButton" Content="擦除范围" Click="Erase_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="WriteButton" Content="写入并校验" Click="Write_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
            </WrapPanel>
            <TextBlock Text="NAND 写入保留物理块地址，先检查目标范围坏块，有坏块即停止；启用片内 ECC，不写 OOB、不改坏块标记。" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
        <TextBox x:Name="LogBox" Grid.Row="5" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"/>
        <StackPanel Grid.Row="6" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="Progress" Height="8" VerticalAlignment="Center"/><Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="Cancel_Click" IsEnabled="False" Margin="12,0,0,0"/></Grid><TextBlock x:Name="StatusText" Text="请连接 HID 模式的 CH347T。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
    </Grid>
</Window>
