<UserControl x:Class="EmbedDesk.App.Controls.NetworkWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EmbedDesk.App.Controls">
    <UserControl.Resources>
        <controls:ConnectionStateBrushConverter x:Key="ConnectionBrush" />
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#59636C" CornerRadius="4" Margin="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="22,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="网络调试" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="选择协议角色，独立管理连接、客户端和报文" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" /></StackPanel></Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SessionColumn" Width="236" MaxWidth="280" MinWidth="180" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="SessionPane" Background="{StaticResource SurfaceBrush}" Padding="10,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="网络会话" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel><Button Grid.Column="1" Style="{StaticResource IconButton}" Click="NewSession_Click" ToolTip="新建网络会话"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" /></Button></Grid></Border>
                    <ListBox Grid.Row="1" Grid.RowSpan="3" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Margin="-6,10,-6,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{Binding State, Converter={StaticResource ConnectionBrush}}" VerticalAlignment="Top" Margin="0,5,0,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Endpoint}" /><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding Protocol}" Foreground="{StaticResource AccentBrush}" FontSize="11" /><TextBlock Text="{Binding Mode}" Style="{StaticResource MutedText}" FontSize="11" Margin="7,0,0,0" /><TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" FontSize="11" Margin="7,0,0,0" /></StackPanel></StackPanel><Button Grid.Column="2" Tag="{Binding}" Style="{StaticResource IconButton}" Width="26" Height="26" Padding="0" Click="CloseSessionItem_Click" ToolTip="关闭会话"><TextBlock Text="×" FontSize="17" /></Button></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="4" Padding="0,10,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><TextBlock Text="{Binding Sessions.Count, StringFormat=共 {0} 个会话}" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" /></Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" />
            <GridSplitter x:Name="SessionSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{StaticResource LineBrush}" DragCompleted="SessionSplitter_DragCompleted" />
            <Button x:Name="SessionToggle" Grid.Column="1" Width="20" Height="72" VerticalAlignment="Center" Style="{StaticResource PaneRestoreButton}" Click="ToggleSessions_Click" ToolTip="收起网络工具"><TextBlock x:Name="SessionToggleGlyph" Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="11" /></Button>
            <Grid Grid.Column="2">
                <Grid x:Name="SessionContent" DataContext="{Binding SelectedSession}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="14,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource ConnectionBrush}}" Margin="0,0,9,0" /><TextBlock Text="{Binding Detail}" ToolTip="{Binding LocalEndpoint, StringFormat=本地绑定：{0}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" Margin="12,0,0,0" /></StackPanel><Button Grid.Column="1" Command="{Binding StartStopCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StartStopGlyph}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" /><TextBlock Text="{Binding StartStopLabel}" /></StackPanel></Button></Grid><Grid Margin="17,8,0,0" Visibility="{Binding IsServer, Converter={StaticResource BooleanVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="连接地址" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock Grid.Column="1" Text="{Binding ServerConnectionAddresses}" TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" /><Button Grid.Column="2" Content="复制" Tag="{Binding ServerConnectionAddresses}" Click="CopyServerAddresses_Click" Margin="10,0,0,0" Padding="9,3" MinHeight="26" /></Grid></StackPanel></Border>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="238" /></Grid.ColumnDefinitions>
                        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="150" MinHeight="120" /></Grid.RowDefinitions>
                            <Border Background="#141A20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="接收" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox Content="HEX" IsChecked="{Binding HexDisplay}" Margin="12,0,0,0" /><CheckBox Content="时间" IsChecked="{Binding ShowTime}" Margin="12,0,0,0" /><CheckBox Content="显示发送" IsChecked="{Binding ShowSent}" Margin="12,0,0,0" /><Button Style="{StaticResource IconButton}" Click="SaveReceive_Click" ToolTip="保存记录" Width="28" Height="26" Margin="8,0,0,0"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" /></Button><Button Style="{StaticResource IconButton}" Command="{Binding Terminal.ClearCommand}" ToolTip="清空记录和计数" Width="28" Height="26"><TextBlock Text="&#xE75C;" Style="{StaticResource Icon}" FontSize="14" /></Button></StackPanel></DockPanel></Border><TextBox x:Name="ReceiveText" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Background="Transparent" BorderThickness="0" Padding="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" /></Grid></Border>
                            <Border Grid.Row="1" Background="#29333D" BorderBrush="#415466" BorderThickness="1" CornerRadius="5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Margin="12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="发送" FontWeight="SemiBold" /><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox Content="HEX" IsChecked="{Binding SendAsHex}" Margin="0,0,12,0" /><CheckBox Content="追加 CRLF" IsChecked="{Binding AppendCrLf}"><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Style.Triggers><DataTrigger Binding="{Binding SendAsHex}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox></StackPanel></Grid><TextBox x:Name="SendTextBox" Grid.Row="1" Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Background="Transparent" BorderThickness="0" Padding="12,4" PreviewKeyDown="Send_KeyDown" /><Grid Grid.Row="2" Margin="12,6,12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Ctrl + Enter 发送" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" /><Button Grid.Column="1" Content="发送" Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" MinWidth="82" /></Grid></Grid></Border>
                        </Grid>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="14,16"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><TextBlock Text="&#xE9E9;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="发送设置" FontWeight="SemiBold" /></StackPanel><TextBlock Text="{Binding SendTargetHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14" /><StackPanel Visibility="{Binding SupportsPeerTargeting, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,14"><TextBlock Text="发送目标" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding PeerTargets}" SelectedItem="{Binding SelectedPeerTarget}" DisplayMemberPath="DisplayName" /></StackPanel><CheckBox Content="自动滚动接收记录" IsChecked="{Binding AutoScroll}" Margin="0,0,0,18" /><TextBlock Text="间隔 / 毫秒" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,6" /><TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" /><Grid Margin="0,10,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="循环发送" Command="{Binding RepeatSendCommand}" /><Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding StopSendingCommand}" ToolTip="停止发送任务"><TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" /></Button></Grid><Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,14" /><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="发送队列" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding AddQueueItemCommand}" ToolTip="加入当前发送内容"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" /></Button><Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding RemoveQueueItemCommand}" ToolTip="移除队列项目"><TextBlock Text="×" FontSize="17" /></Button></Grid><DataGrid x:Name="QueueGrid" Height="142" ItemsSource="{Binding SendQueue}" SelectedItem="{Binding SelectedQueueItem}" RowHeight="28" ColumnHeaderHeight="28"><DataGrid.Columns><DataGridCheckBoxColumn Header="选" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="38" /><DataGridTextColumn Header="内容" Binding="{Binding Payload, UpdateSourceTrigger=PropertyChanged}" Width="*" /></DataGrid.Columns></DataGrid><CheckBox Content="重复队列" IsChecked="{Binding QueueRepeat}" Margin="0,12,0,10" /><Button Content="运行队列" Command="{Binding RunQueueCommand}" /><TextBlock Text="{Binding JobStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,14" /><Expander Header="HTTP 诊断" Foreground="{StaticResource TextBrush}" Visibility="{Binding TreatAsHttp, Converter={StaticResource BooleanVisibility}}"><StackPanel Margin="0,10,0,0"><TextBlock Text="最近接收片段" Style="{StaticResource MutedText}" FontSize="11" /><TextBox Text="{Binding HttpStartLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,4" /><TextBox Text="{Binding HttpHeadersText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" /></StackPanel></Expander></StackPanel></ScrollViewer></Border>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding LastMessage}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" /><StackPanel Grid.Column="1" Orientation="Horizontal"><controls:NetworkStatusIndicator DataContext="{Binding NetworkStatus}" Margin="0,0,10,0" /><TextBlock Text="{Binding Terminal.ReceivedBytes, StringFormat=RX {0:N0} B}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,14,0" /><TextBlock Text="{Binding Terminal.SentBytes, StringFormat=TX {0:N0} B}" Foreground="#9FC5ED" FontSize="11" /></StackPanel></Grid></Border>
                </Grid>
                <Border x:Name="EmptyState" Background="{StaticResource PanelBrush}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"><TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,20" /><TextBlock Text="建立第一个网络会话" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="点击左侧会话标题右上角的 +，先选择协议类型，再填写连接信息。" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,22" /><Button Content="新建会话" Style="{StaticResource PrimaryButton}" Click="NewSession_Click" HorizontalAlignment="Center" Padding="24,8" /></StackPanel></Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
