<UserControl x:Class="EmbedDesk.App.Controls.DebugToolConnectionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <WrapPanel x:Name="SettingsPanel">
   <StackPanel Width="122" Margin="0,0,8,6"><TextBlock Text="传输方式" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><ComboBox x:Name="TransportBox" SelectionChanged="Transport_Changed"/></StackPanel>
   <StackPanel x:Name="SerialPanel" Width="220" Margin="0,0,8,6"><TextBlock Text="串口设备" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><ComboBox x:Name="PortBox" DisplayMemberPath="DisplayName" ToolTip="独占使用；不关闭其他会话"/></StackPanel>
   <StackPanel x:Name="BaudPanel" Width="112" Margin="0,0,8,6"><TextBlock Text="波特率 · 8N1" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><ComboBox x:Name="BaudBox" IsEditable="True" Padding="8,5,28,5"/></StackPanel>
   <StackPanel x:Name="HostPanel" Width="220" Margin="0,0,8,6" Visibility="Collapsed"><TextBlock x:Name="HostLabel" Text="远程地址" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="HostBox" Text="127.0.0.1"/></StackPanel>
   <StackPanel x:Name="PortPanel" Width="90" Margin="0,0,8,6" Visibility="Collapsed"><TextBlock Text="端口" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBox x:Name="NetworkPortBox" Text="9000"/></StackPanel>
   <Button x:Name="RefreshButton" Content="刷新串口" Click="Refresh_Click" Margin="0,22,8,6"/>
  </WrapPanel>
  <WrapPanel x:Name="ActionPanel" Margin="0,4,0,0"><Button x:Name="ConnectButton" Content="连接 / 监听" Click="Connect_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="StopButton" Content="断开" Click="Stop_Click" IsEnabled="False" Margin="0,0,12,0"/><TextBlock x:Name="StateText" Text="未连接 · 串口 8N1，流控 / DTR / RTS 关闭" VerticalAlignment="Center" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></WrapPanel>
 </StackPanel>
</UserControl>
