<UserControl x:Class="EmbedDesk.App.Controls.RemoteDebugWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EmbedDesk.App.Controls" xmlns:vm="clr-namespace:EmbedDesk.App.ViewModels">
    <UserControl.Resources>
        <controls:RemoteProtocolLabelConverter x:Key="RemoteProtocolLabel" />
        <controls:ProfileGlyphConverter x:Key="ProfileGlyph" />
        <controls:RemoteAuthenticationLabelConverter x:Key="RemoteAuthenticationLabel" />
        <controls:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibility" />
        <controls:BooleanToGridLengthConverter x:Key="BooleanToGridLength" />
        <controls:InverseBooleanToGridLengthConverter x:Key="InverseBooleanToGridLength" />
        <controls:ConnectionStateBrushConverter x:Key="ConnectionStateBrush" />
        <controls:HostPlatformIconConverter x:Key="HostPlatformIcon" />
        <controls:ActiveTabBrushConverter x:Key="ActiveTabBrush" />
        <controls:ActiveTabVisibilityConverter x:Key="ActiveTabVisibility" />
        <controls:TabCloseVisibilityConverter x:Key="TabCloseVisibility" />
        <DataTemplate DataType="{x:Type vm:LocalShellViewModel}">
            <StackPanel Orientation="Horizontal"><Image Source="/EmbedDesk.App;component/Assets/Platforms/windows11.png" Width="20" Height="20" Margin="0,0,8,0" /><TextBlock Text="本地 Shell" VerticalAlignment="Center" /></StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RemoteWorkspaceViewModel}">
            <StackPanel Orientation="Horizontal"><Image Source="{Binding HostPlatform, Converter={StaticResource HostPlatformIcon}}" Width="20" Height="20" Margin="0,0,8,0" ToolTip="{Binding HostPlatform}" /><TextBlock Text="{Binding DisplayTitle}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Ellipse Width="7" Height="7" Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionStateBrush}}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding ConnectionStatus}" /></StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DesktopSessionViewModel}">
            <StackPanel Orientation="Horizontal"><Image Source="{Binding HostPlatform, Converter={StaticResource HostPlatformIcon}}" Width="20" Height="20" Margin="0,0,8,0" /><TextBlock Text="{Binding DisplayTitle}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Text="{Binding ProtocolLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" /><Ellipse Width="7" Height="7" Fill="{Binding ConnectionStatus, Converter={StaticResource ConnectionStateBrush}}" Margin="8,0,0,0" ToolTip="{Binding ConnectionStatus}" /></StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RemoteFileDocumentViewModel}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Location}"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="{Binding Title}" MaxWidth="170" TextTrimming="CharacterEllipsis" /></StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TerminalMark">
            <Border Width="24" Height="24" CornerRadius="4" Background="{StaticResource SelectedBrush}">
                <TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ProfileTemplate">
            <Grid Height="46" Margin="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Protocol, Converter={StaticResource ProfileGlyph}}" FontSize="17" Foreground="{StaticResource AccentBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Host}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Visibility="{Binding IsTerminalFullscreen, Converter={StaticResource InverseBooleanVisibility}}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="远程调试" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="本地 Shell · SSH / Telnet · RDP / VNC" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="KeyManager_Click" ToolTip="SSH 密钥管理器"><TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" /></Button>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SessionColumn" Width="{Binding SessionPaneWidth, Mode=TwoWay}" MinWidth="{Binding SessionPaneMinWidth}" MaxWidth="236" /><ColumnDefinition x:Name="SessionRailColumn" Width="{Binding IsTerminalFullscreen, Converter={StaticResource InverseBooleanToGridLength}, ConverterParameter=20}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" Visibility="{Binding IsTerminalFullscreen, Converter={StaticResource InverseBooleanVisibility}}" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{StaticResource LineBrush}" Visibility="{Binding IsSessionPaneVisible, Converter={StaticResource BooleanVisibility}}" ToolTip="拖动调整会话栏宽度" />
            <Button x:Name="SessionPaneToggle" Grid.Column="1" Width="20" Height="72" VerticalAlignment="Center" Style="{StaticResource PaneRestoreButton}" Command="{Binding ToggleSessionPaneCommand}" Visibility="{Binding IsTerminalFullscreen, Converter={StaticResource InverseBooleanVisibility}}" ToolTip="{Binding SessionPaneToggleTooltip}"><TextBlock Text="{Binding SessionPaneToggleGlyph}" Style="{StaticResource Icon}" FontSize="11" /></Button>
            <Border Visibility="{Binding IsSessionPaneVisible, Converter={StaticResource BooleanVisibility}}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="10,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="terminal" ContentTemplate="{StaticResource TerminalMark}" Margin="0,0,8,0" />
                            <TextBlock Text="会话" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Click="NewConnection_Click" ToolTip="新增连接"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" /></Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ItemTemplate="{StaticResource ProfileTemplate}" BorderThickness="0" Margin="-6,12,-6,12" MouseDoubleClick="Profile_MouseDoubleClick" />
                        <TextBlock Text="暂无连接，点击上方 + 新增" Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="{Binding HasProfiles, Converter={StaticResource InverseBooleanVisibility}}" />
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel HorizontalAlignment="Stretch" MaxWidth="190">
                            <TextBlock Text="连接信息" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" />
                            <TextBlock Text="{Binding SelectedProfile.Name, TargetNullValue=未选择连接}" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            <TextBlock Text="{Binding ProfileEditor.Endpoint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            <TextBlock Text="{Binding ProfileEditor.Username}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"><Button Content="编辑" Click="EditConnection_Click" IsEnabled="{Binding CanDeleteSelectedProfile}" Margin="0,0,7,0" /><Button Content="删除" Click="DeleteConnection_Click" IsEnabled="{Binding CanDeleteSelectedProfile}" /></StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Height="46" Visibility="{Binding IsTerminalFullscreen, Converter={StaticResource InverseBooleanVisibility}}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,0">
                    <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Tabs_MouseWheel" AllowDrop="True" DragOver="Tabs_DragOver" Drop="Tabs_Drop">
                        <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Height="45" Margin="0,0,4,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                                        PreviewMouseLeftButtonDown="Tab_MouseDown" PreviewMouseMove="Tab_MouseMove" AllowDrop="True" DragOver="Tab_DragOver" DragLeave="Tab_DragLeave" Drop="Tab_Drop">
                                    <Border.Background><MultiBinding Converter="{StaticResource ActiveTabBrush}"><Binding /><Binding Path="DataContext.ActiveTab" RelativeSource="{RelativeSource AncestorType=controls:RemoteDebugWorkspace}" /></MultiBinding></Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="SelectTab_Click" Padding="10,4" Background="Transparent" BorderThickness="0" Cursor="Hand"><ContentControl Content="{Binding}" /></Button>
                                        <Button Width="26" Height="26" Style="{StaticResource IconButton}" Tag="CloseTab" Click="CloseTab_Click" ToolTip="关闭标签" Margin="0,0,3,0" Visibility="{Binding Converter={StaticResource TabCloseVisibility}}"><TextBlock Text="×" FontSize="17" Foreground="{StaticResource MutedBrush}" /></Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="1">
                    <ContentControl Content="{Binding LocalShell}" Visibility="{Binding IsLocalShellSelected, Converter={StaticResource BooleanVisibility}}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Grid Background="{StaticResource InputBrush}">
                                    <controls:ShellTerminal Buffer="{Binding Terminal}" IsFullscreen="{Binding IsFullscreen}" InputReceived="LocalShell_InputReceived" FullscreenRequested="ToggleLocalFullscreen_Click" />
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ActiveTabVisibility}"><Binding /><Binding Path="DataContext.ActiveTab" RelativeSource="{RelativeSource AncestorType=controls:RemoteDebugWorkspace}" /></MultiBinding></Setter.Value></Setter></Style></ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate><DataTemplate><controls:RemoteWorkspace /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding DesktopSessions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource ActiveTabVisibility}"><Binding /><Binding Path="DataContext.ActiveTab" RelativeSource="{RelativeSource AncestorType=controls:RemoteDebugWorkspace}" /></MultiBinding></Setter.Value></Setter></Style></ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate><DataTemplate><controls:DesktopWorkspace /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl Content="{Binding SelectedDocument}" Visibility="{Binding IsDocumentSelected, Converter={StaticResource BooleanVisibility}}">
                        <ContentControl.ContentTemplate><DataTemplate><controls:RemoteFileDocument /></DataTemplate></ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

