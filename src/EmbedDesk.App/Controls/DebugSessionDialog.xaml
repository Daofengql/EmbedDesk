<UserControl x:Class="EmbedDesk.App.Controls.DebugSessionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EmbedDesk.App.Controls"
             Focusable="True" PreviewKeyDown="Dialog_KeyDown">
    <UserControl.Resources>
        <local:SerialOptionLabelConverter x:Key="SerialOptionLabel" />
        <DataTemplate x:Key="SerialOptionTemplate"><TextBlock Text="{Binding Converter={StaticResource SerialOptionLabel}}" /></DataTemplate>
        <Style x:Key="SessionCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="68" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Heading" Text="新建调试会话" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="Description" Text="选择会话类型，每个会话独立连接与收发。" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="Cancel_Click" ToolTip="关闭" VerticalAlignment="Top" Margin="12,0,0,0"><TextBlock Text="×" FontSize="20" /></Button>
        </Grid>
        <ScrollViewer x:Name="DialogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="TypePicker">
                    <TextBlock Text="基础通信" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" />
                    <UniformGrid Columns="3" Margin="-4,0,-4,12">
                        <Button x:Name="SerialTypeButton" Style="{StaticResource SessionCard}" Tag="Serial" Click="Type_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE958;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="18" Margin="0,0,8,0" /><TextBlock Text="串口调试" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Style="{StaticResource SessionCard}" Tag="NetworkClient" Click="Type_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="18" Margin="0,0,8,0" /><TextBlock Text="TCP/UDP 客户端" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Style="{StaticResource SessionCard}" Tag="NetworkServer" Click="Type_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="18" Margin="0,0,8,0" /><TextBlock Text="TCP/UDP 服务端" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Button>
                    </UniformGrid>
                    <TextBlock Text="设备调试" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" />
                    <UniformGrid Columns="2" Margin="-4,0,-4,12">
                        <Button Style="{StaticResource SessionCard}" Tag="Pid" Click="Type_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="21" Margin="0,0,12,0" /><StackPanel><TextBlock Text="PID 调试" FontWeight="SemiBold" /><TextBlock Text="参数 / 曲线 / 滤波" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" /></StackPanel></StackPanel></Button>
                        <Button Style="{StaticResource SessionCard}" Tag="Camera" Click="Type_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="21" Margin="0,0,12,0" /><StackPanel><TextBlock Text="摄像头调试" FontWeight="SemiBold" /><TextBlock Text="接收开发板图像" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" /></StackPanel></StackPanel></Button>
                    </UniformGrid>
                    <TextBlock Text="应用协议" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" />
                    <UniformGrid Columns="1" Margin="-4,0,-4,0">
                        <Button Style="{StaticResource SessionCard}" Tag="Mqtt" Click="Type_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="18" Margin="0,0,8,0" /><TextBlock Text="MQTT 客户端" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel></Button>
                    </UniformGrid>
                </StackPanel>
                <StackPanel x:Name="ConnectionFields" Visibility="Collapsed">
                    <Grid x:Name="TransportFields" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="TransportLabel" Text="连接方式" VerticalAlignment="Center" /><ComboBox x:Name="TransportBox" Grid.Column="1" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Transport_Changed" /></Grid>
                    <Grid x:Name="ProtocolFields" Margin="0,0,0,14" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="协议" VerticalAlignment="Center" /><ComboBox x:Name="ProtocolBox" Grid.Column="1" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Protocol_Changed" /></Grid>
                    <StackPanel x:Name="SerialFields">
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="串口设备" VerticalAlignment="Center" /><ComboBox x:Name="PortBox" Grid.Column="1" IsEditable="True" DisplayMemberPath="SelectionLabel" SelectedValuePath="PortName" Padding="8,5,28,5" ToolTip="选择串口设备，或输入设备名称；也可稍后设置" /><Button x:Name="RefreshButton" Grid.Column="2" Content="刷新" Click="Refresh_Click" Margin="8,0,0,0" /></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                            <TextBlock Text="波特率" VerticalAlignment="Center" /><TextBox x:Name="BaudBox" Grid.Column="1" Text="115200" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="数据位" Margin="16,0,0,0" VerticalAlignment="Center" /><ComboBox x:Name="DataBitsBox" Grid.Column="3" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="校验" VerticalAlignment="Center" /><ComboBox x:Name="ParityBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" ItemTemplate="{StaticResource SerialOptionTemplate}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="停止位" Margin="16,0,0,0" VerticalAlignment="Center" /><ComboBox x:Name="StopBitsBox" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" ItemTemplate="{StaticResource SerialOptionTemplate}" />
                            <TextBlock Grid.Row="2" Text="流控" VerticalAlignment="Center" /><ComboBox x:Name="FlowBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" ItemTemplate="{StaticResource SerialOptionTemplate}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="NetworkFields">
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><TextBlock x:Name="HostLabel" Text="远程地址" VerticalAlignment="Center" /><TextBox x:Name="HostBox" Grid.Column="1" /><TextBlock Grid.Column="2" Text="端口" Margin="12,0,0,0" VerticalAlignment="Center" /><TextBox x:Name="PortNumberBox" Grid.Column="3" /></Grid>
                        <Grid x:Name="LocalFields" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><TextBlock Text="本地绑定地址" VerticalAlignment="Center" /><TextBox x:Name="LocalHostBox" Grid.Column="1" Text="0.0.0.0" /><TextBlock Grid.Column="2" Text="端口" Margin="12,0,0,0" VerticalAlignment="Center" /><TextBox x:Name="LocalPortBox" Grid.Column="3" Text="0" /></Grid>
                        <Grid x:Name="TimeoutFields" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="连接超时 / ms" VerticalAlignment="Center" /><TextBox x:Name="TimeoutBox" Grid.Column="1" Text="10000" /></Grid>
                    </StackPanel>
                    <CheckBox x:Name="LockUdpPeerBox" Content="锁定首个发送端" Checked="UdpMode_Changed" Unchecked="UdpMode_Changed" Visibility="Collapsed" Margin="0,0,0,12" />
                    <StackPanel x:Name="MqttFields" Visibility="Collapsed">
                        <TextBlock Text="订阅 / 发布主题" Style="{StaticResource MutedText}" Margin="0,0,0,6" /><TextBox x:Name="MqttTopicBox" Text="embeddesk" />
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="用户名（可选）" Style="{StaticResource MutedText}" Margin="0,0,0,6" /><TextBox x:Name="MqttUsernameBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="密码（可选）" Style="{StaticResource MutedText}" Margin="0,0,0,6" /><PasswordBox x:Name="MqttPasswordBox" /></StackPanel></Grid>
                        <CheckBox x:Name="MqttTlsBox" Content="使用 TLS" Margin="0,12,0,0" />
                    </StackPanel>
                    <CheckBox x:Name="ReconnectBox" Content="连接中断后自动重连" Margin="0,2,0,0" />
                    <TextBlock x:Name="ModeHint" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="#F0A4A4" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="BackButton" Content="返回" Click="Back_Click" Visibility="Collapsed" /><Button x:Name="CancelButton" Grid.Column="2" Content="取消" Click="Cancel_Click" MinWidth="80" /><Button x:Name="ApplyButton" Grid.Column="3" Content="创建会话" Style="{StaticResource PrimaryButton}" Click="Apply_Click" Visibility="Collapsed" MinWidth="104" Margin="8,0,0,0" /></Grid>
        </Grid>
    </Grid>
</UserControl>
