<UserControl x:Class="EmbedDesk.App.Controls.ConnectionCenterWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbedDesk.App.Controls">
 <UserControl.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="16"/></Style>
  <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Margin" Value="10,0,0,0"/></Style>
 </UserControl.Resources>
 <Grid Margin="22,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="160"/><RowDefinition Height="12"/><RowDefinition Height="92"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="本机设备" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding RelayName}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelayName}" HorizontalAlignment="Right" Margin="20,0,0,0"/></DockPanel>
     <Grid Grid.Row="1" Margin="0,12,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="设备 ID" Style="{StaticResource MutedText}"/>
       <DockPanel Margin="0,5,0,0"><Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopyDeviceId_Click" ToolTip="复制设备 ID" AutomationProperties.Name="复制设备 ID"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></Button><TextBlock x:Name="DeviceIdDisplay" Text="{Binding DeviceId}" FontSize="30" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}"/></DockPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="连接密码" Style="{StaticResource MutedText}"/>
       <DockPanel Margin="0,5,0,0"><Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopyPassword_Click" ToolTip="复制连接密码" AutomationProperties.Name="复制连接密码"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/></Button><TextBlock x:Name="PasswordDisplay" Text="{Binding PasswordDisplay}" FontSize="21" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Ellipse Width="7" Height="7" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
       <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" MaxWidth="270"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="重新上线" Click="Start_Click" MinHeight="28" Padding="8,4" Margin="8,0,6,0"/><Button Content="停止" Click="Stop_Click" MinHeight="28" Padding="8,4"/></StackPanel>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="连接另一台设备" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock Text="对方设备 ID" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><ComboBox x:Name="TargetDeviceId" IsEditable="True" Height="34" VerticalAlignment="Top" ItemsSource="{Binding RecentIds}" Text="{Binding TargetId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="对方密码" Style="{StaticResource MutedText}" Margin="0,0,0,5"/><PasswordBox x:Name="RemotePassword" Height="34" VerticalAlignment="Top" VerticalContentAlignment="Center"/></StackPanel>
     </Grid>
     <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="密码留空时请求对方授权" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button Content="连接设备" Click="Connect_Click" Style="{StaticResource PrimaryButton}" MinWidth="88"/>
       <Button Content="取消请求" Click="CancelConnect_Click" Visibility="{Binding IsConnecting, Converter={StaticResource BooleanVisibility}}" Margin="8,0,0,0"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="12,8">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="设备连接" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <ListBox Grid.Row="1" x:Name="ConnectedDevices" ItemsSource="{Binding Peers}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{Binding DeviceId}" FontFamily="Consolas"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/></StackPanel>
       <Button Grid.Column="1" Content="断开" Click="Disconnect_Click" MinHeight="28" Padding="8,4" Margin="8,0,0,0"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Grid.Row="1" Text="尚未连接其他设备" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Peers.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,8">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="等待授权" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <ListBox Grid.Row="1" x:Name="AuthorizationRequests" ItemsSource="{Binding Approvals}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="允许" Click="Approve_Click" MinHeight="28" Padding="8,4" Margin="8,0,6,0"/><Button Content="拒绝" Click="Deny_Click" MinHeight="28" Padding="8,4"/></StackPanel>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Grid.Row="1" Text="没有待处理的请求" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Approvals.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" Text="{Binding Error}" Foreground="#FFB4A5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Border x:Name="MappingControlCard" Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="映射设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <local:DeviceServicesControl x:Name="ServicesControl" Grid.Row="1"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>
