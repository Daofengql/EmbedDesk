<UserControl x:Class="EmbedDesk.App.Controls.DeviceServicesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="ServiceList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="LocalMappingPanel">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRemoteMappingMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="串口选择" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
            <ListBox Grid.Row="1" x:Name="LocalSerialServicesList" Style="{StaticResource ServiceList}"
                     ItemsSource="{Binding LocalSerialServices}"
                     SelectedItem="{Binding SelectedLocalSerialService}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PortName}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description, TargetNullValue=未提供设备描述}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                <Button Content="添加串口" Click="AddSerial_Click" Margin="0,0,8,0" />
                <Button Content="编辑" Click="EditSerial_Click" Margin="0,0,8,0" />
                <Button Content="删除" Click="DeleteSerial_Click" />
            </WrapPanel>

            <TextBlock Grid.Column="2" Text="向外映射的服务" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
            <ListBox Grid.Row="1" Grid.Column="2" x:Name="LocalNetworkServicesList" Style="{StaticResource ServiceList}"
                     ItemsSource="{Binding LocalNetworkServices}"
                     SelectedItem="{Binding SelectedLocalNetworkService}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProtocolLabel}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding Endpoint}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Endpoint}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                <Button Content="添加服务" Click="AddNetwork_Click" Margin="0,0,8,0" />
                <Button Content="编辑" Click="EditNetwork_Click" Margin="0,0,8,0" />
                <Button Content="删除" Click="DeleteNetwork_Click" />
            </WrapPanel>
        </Grid>

        <Grid x:Name="RemoteMappingPanel">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRemoteMappingMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="对端发布的服务" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
            <ListBox Grid.Row="1" x:Name="RemoteServicesList" Style="{StaticResource ServiceList}"
                     ItemsSource="{Binding RemoteServices}"
                     SelectedItem="{Binding SelectedRemoteService}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center">
                <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsSerialServiceSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                <TextBlock Text="本机端口" VerticalAlignment="Center" />
                <TextBox x:Name="LocalPort" Width="84" MaxLength="5" Text="22022" Margin="8,0" VerticalAlignment="Center" />
                <Button Content="保存并启用" Click="Map_Click" VerticalAlignment="Center" />
            </WrapPanel>
            <WrapPanel Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center">
                <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSerialServiceSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                <Button x:Name="UseRemoteSerialButton" Content="使用串口…" Click="UseSerial_Click" ToolTip="选择在本软件内使用，或映射为系统虚拟 COM"/>
            </WrapPanel>

            <TextBlock Grid.Column="2" Text="本地映射" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
            <ListBox Grid.Row="1" Grid.Column="2" x:Name="MappingRulesList" Style="{StaticResource ServiceList}"
                     ItemsSource="{Binding MappingRules}"
                     SelectedItem="{Binding SelectedRule}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ToolTip="规则保存在本机；设备断线或重启后手动启用。">
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" VerticalAlignment="Center">
                <Button Content="启用" Click="EnableRule_Click" Margin="0,0,8,0" />
                <Button Content="停用" Click="Unmap_Click" Margin="0,0,8,0" />
                <Button Content="删除规则" Click="DeleteRule_Click" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
