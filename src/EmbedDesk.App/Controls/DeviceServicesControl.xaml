<UserControl x:Class="EmbedDesk.App.Controls.DeviceServicesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="ServiceList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <DataTemplate x:Key="MappingRuleTemplate">
            <StackPanel ToolTip="{Binding DisplayName}">
                <TextBlock Text="{Binding LocalEndpoint}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding RemoteTarget, StringFormat='→ {0}'}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                <TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SerialRuleAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=SerialMappingRulesList}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="NetworkRuleAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=NetworkMappingRulesList}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="LocalMappingPanel">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRemoteMappingMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="串口选择" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
            <ListBox Grid.Row="1" x:Name="LocalSerialServicesList" Style="{StaticResource ServiceList}"
                     ItemsSource="{Binding LocalSerialServices}"
                     SelectedItem="{Binding SelectedLocalSerialService}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PortName}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description, TargetNullValue=未提供设备描述}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                <Button Content="添加串口" Click="AddSerial_Click" Margin="0,0,8,0" />
                <Button Content="编辑" Click="EditSerial_Click" Margin="0,0,8,0" />
                <Button Content="删除" Click="DeleteSerial_Click" />
            </WrapPanel>

            <TextBlock Grid.Column="2" Text="向外映射的服务" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
            <ListBox Grid.Row="1" Grid.Column="2" x:Name="LocalNetworkServicesList" Style="{StaticResource ServiceList}"
                     ItemsSource="{Binding LocalNetworkServices}"
                     SelectedItem="{Binding SelectedLocalNetworkService}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProtocolLabel}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding Endpoint}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Endpoint}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                <Button Content="添加服务" Click="AddNetwork_Click" Margin="0,0,8,0" />
                <Button Content="编辑" Click="EditNetwork_Click" Margin="0,0,8,0" />
                <Button Content="删除" Click="DeleteNetwork_Click" />
            </WrapPanel>
        </Grid>

        <Grid x:Name="RemoteMappingPanel">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRemoteMappingMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="串口映射" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Grid.Row="1">
                <ListBox x:Name="SerialMappingRulesList" Style="{StaticResource ServiceList}" ItemsSource="{Binding SerialMappingRules}"
                         ItemTemplate="{StaticResource MappingRuleTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ToolTip="本机 COM → 对端串口；规则保存在本机，设备重连后手动启用。" />
                <TextBlock Text="尚无串口映射&#x0a;点击“添加”选择对端串口。" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=SerialMappingRulesList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                <Button x:Name="AddSerialMappingButton" Content="添加" Click="AddSerialMapping_Click" Margin="0,0,6,0" ToolTip="选择对端串口，在本软件内使用或映射为系统 COM" />
                <Button x:Name="EnableSerialMappingButton" Content="启用" Click="EnableSerialRule_Click" Style="{StaticResource SerialRuleAction}" />
                <Button Content="停用" Click="DisableSerialRule_Click" Style="{StaticResource SerialRuleAction}" />
                <Button Content="删除" Click="DeleteSerialRule_Click" Style="{StaticResource SerialRuleAction}" Margin="0" />
            </WrapPanel>

            <TextBlock Grid.Column="2" Text="端口映射" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid Grid.Row="1" Grid.Column="2">
                <ListBox x:Name="NetworkMappingRulesList" Style="{StaticResource ServiceList}" ItemsSource="{Binding NetworkMappingRules}"
                         ItemTemplate="{StaticResource MappingRuleTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ToolTip="本机回环端口 → 对端已发布的 TCP / UDP 目标；设备重连后手动启用。" />
                <TextBlock Text="尚无端口映射&#x0a;点击“添加”选择 TCP / UDP 目标。" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=NetworkMappingRulesList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <WrapPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                <Button x:Name="AddNetworkMappingButton" Content="添加" Click="AddNetworkMapping_Click" Margin="0,0,6,0" ToolTip="选择对端已发布的网络目标，设置本机监听端口" />
                <Button x:Name="EnableNetworkMappingButton" Content="启用" Click="EnableNetworkRule_Click" Style="{StaticResource NetworkRuleAction}" />
                <Button Content="停用" Click="DisableNetworkRule_Click" Style="{StaticResource NetworkRuleAction}" />
                <Button Content="删除" Click="DeleteNetworkRule_Click" Style="{StaticResource NetworkRuleAction}" Margin="0" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
