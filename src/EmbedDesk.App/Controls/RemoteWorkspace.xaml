<UserControl x:Class="EmbedDesk.App.Controls.RemoteWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EmbedDesk.App.Controls">
    <UserControl.Resources>
        <local:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibility" />
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid x:Name="PART_Track" Background="{StaticResource InputBrush}" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" /></Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="IsReadOnly" Value="True" /><Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="25" /><Setter Property="ColumnHeaderHeight" Value="26" /><Setter Property="FontSize" Value="12" />
            <Setter Property="SelectionUnit" Value="FullRow" /><Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="5,2" /></Style></Setter.Value></Setter>
            <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="5,3" /></Style></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="FileName">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding IconGlyph}" Style="{StaticResource Icon}" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="DockLayout" Grid.Row="0" Margin="8" SizeChanged="DockLayout_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="100" /><RowDefinition x:Name="BottomGap" Height="22" /><RowDefinition x:Name="DirectoryRow" Height="0" /></Grid.RowDefinitions>
            <Border x:Name="DirectoryPane" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True" SizeChanged="DirectoryPane_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}">
                        <Border x:Name="DirectoryDragHandle" HorizontalAlignment="Left" Background="Transparent" Padding="8,0" Cursor="SizeAll"
                                PreviewMouseLeftButtonDown="DirectoryDrag_MouseDown" PreviewMouseMove="DirectoryDrag_MouseMove"
                                PreviewMouseLeftButtonUp="DirectoryDrag_MouseUp" LostMouseCapture="DirectoryDrag_LostMouseCapture"
                                ToolTip="拖动“文件”可独立为窗口，再拖到主窗口底部可合并">
                            <Border.ContextMenu><ContextMenu><MenuItem x:Name="DetachMenuItem" Header="在独立窗口中打开" Click="DetachFiles_Click" /><MenuItem x:Name="DockMenuItem" Header="合并回底部" Click="DockFiles_Click" IsEnabled="False" /></ContextMenu></Border.ContextMenu>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE784;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,7,0" /><TextBlock Text="文件" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                    </Border>
                    <Grid x:Name="FilePanes" Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="LocalColumn" Width="0" /><ColumnDefinition x:Name="LocalGap" Width="0" /><ColumnDefinition Width="*" MinWidth="180" /></Grid.ColumnDefinitions>
                        <Grid x:Name="LocalPane" Visibility="Collapsed" Margin="6">
                            <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="本地目录" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBox x:Name="LocalPathBox" Grid.Row="1" Text="{Binding LocalPath, Mode=OneWay}" KeyDown="LocalPath_KeyDown" MinHeight="28" Padding="6,4" FontSize="12" Margin="0,0,0,6" ToolTip="输入本地路径后按 Enter" />
                            <DataGrid x:Name="LocalFiles" Grid.Row="2" ItemsSource="{Binding LocalEntries}" Style="{StaticResource FileGrid}" MouseDoubleClick="LocalDirectory_MouseDoubleClick" PreviewMouseRightButtonDown="FileGrid_RightClick">
                                <DataGrid.ContextMenu><ContextMenu Opened="LocalMenu_Opened"><MenuItem Header="打开目录" Tag="open" Click="OpenLocal_Click" /><MenuItem Header="上传到当前远程目录" Tag="upload" Click="UploadLocal_Click" /><Separator /><MenuItem Header="刷新" Click="RefreshLocal_Click" /><MenuItem Header="选择本地目录…" Click="ChooseLocalFolder_Click" /><MenuItem Header="复制路径" Click="CopyLocalPath_Click" /></ContextMenu></DataGrid.ContextMenu>
                                <DataGrid.Columns><DataGridTemplateColumn Header="名称" Width="*" CellTemplate="{StaticResource FileName}" /><DataGridTextColumn Header="大小" Binding="{Binding SizeLabel}" Width="72" /></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <GridSplitter x:Name="LocalSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{StaticResource LineBrush}" Visibility="Collapsed" />
                        <Grid Grid.Column="2" Margin="6">
                            <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="远程目录" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBox x:Name="RemotePathBox" Grid.Row="1" Text="{Binding Path, Mode=OneWay}" KeyDown="RemotePath_KeyDown" MinHeight="28" Padding="6,4" FontSize="12" Margin="0,0,0,6" ToolTip="输入远程路径后按 Enter" />
                            <DataGrid x:Name="RemoteFiles" Grid.Row="2" ItemsSource="{Binding DirectoryEntries}" SelectedItem="{Binding SelectedEntry}" Style="{StaticResource FileGrid}" MouseDoubleClick="Directory_MouseDoubleClick" PreviewMouseRightButtonDown="FileGrid_RightClick" Visibility="{Binding SupportsDirectoryManagement, Converter={StaticResource BooleanVisibility}}">
                                <DataGrid.ContextMenu><ContextMenu Opened="RemoteMenu_Opened" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="打开 / 预览" Tag="open" Click="OpenRemote_Click" />
                                    <MenuItem Header="下载到本地目录" Tag="download" Click="DownloadToLocal_Click" />
                                    <MenuItem Header="另存为…" Tag="download" Click="Download_Click" />
                                    <MenuItem Header="上传文件…" Tag="transfer" Click="Upload_Click" />
                                    <Separator />
                                    <MenuItem Header="返回上级" Command="{Binding GoUpCommand}" />
                                    <MenuItem Header="刷新" Command="{Binding RefreshDirectoryCommand}" />
                                    <MenuItem Header="新建目录" Command="{Binding CreateDirectoryCommand}" />
                                    <MenuItem Header="复制路径" Click="CopyRemotePath_Click" />
                                    <Separator /><MenuItem Header="删除文件…" Tag="delete" Click="DeleteRemote_Click" />
                                </ContextMenu></DataGrid.ContextMenu>
                                <DataGrid.Columns><DataGridTemplateColumn Header="名称" Width="*" CellTemplate="{StaticResource FileName}" /><DataGridTextColumn Header="大小" Binding="{Binding SizeLabel}" Width="68" /></DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="{Binding DirectoryStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SupportsDirectoryManagement, Converter={StaticResource InverseBooleanVisibility}}" />
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="6,2">
                        <TextBlock Text="{Binding FileStatus}" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastError}" FontSize="11" Foreground="#EFA6A6" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter x:Name="DirectorySplitter" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{StaticResource SurfaceBrush}" DragCompleted="DirectorySplitter_DragCompleted" ToolTip="拖动调整文件区高度" />
            <Button x:Name="DirectoryRestore" Grid.Row="1" Width="72" Height="22" HorizontalAlignment="Center" Style="{StaticResource PaneRestoreButton}" Click="RestoreFiles_Click" ToolTip="收起目录"><StackPanel Orientation="Horizontal"><TextBlock x:Name="DirectoryToggleGlyph" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" /><TextBlock x:Name="FloatingLabel" Text=" 文件已在独立窗口打开" FontSize="11" Visibility="Collapsed" Margin="6,0,0,0" /></StackPanel></Button>
            <Border x:Name="ShellPane" Background="#171B1F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="1">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Height="34" Visibility="{Binding IsTerminalFullscreen, Converter={StaticResource InverseBooleanVisibility}}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                        <Border.ContextMenu><ContextMenu><MenuItem Header="查看 SSH 连接日志" Click="ShowConnectionLog_Click" /></ContextMenu></Border.ContextMenu>
                        <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Click="ToggleFullscreen_Click" IsEnabled="{Binding IsWorkspaceReady}" ToolTip="终端全屏"><TextBlock Text="⛶" FontSize="16" /></Button><Button Style="{StaticResource IconButton}" Command="{Binding Terminal.ClearCommand}" ToolTip="清空终端"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" /></Button></StackPanel><TextBlock Text="远程终端" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
                    </Border>
                    <local:ShellTerminal x:Name="TerminalControl" Grid.Row="1" Buffer="{Binding Terminal}" IsFullscreen="{Binding IsTerminalFullscreen}" IsOutputVisible="{Binding IsWorkspaceReady}" InputReceived="Terminal_InputReceived" ResizeReceived="Terminal_ResizeReceived" FullscreenRequested="Terminal_FullscreenRequested" />
                    <Grid Grid.Row="1" Background="{StaticResource InputBrush}" Visibility="{Binding IsWorkspaceReady, Converter={StaticResource InverseBooleanVisibility}}" Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding ConnectionDetail}" Margin="6,4,6,10" Style="{StaticResource MutedText}" />
                        <TextBox x:Name="ConnectionLogView" Grid.Row="1" Text="{Binding ConnectionLogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono,Consolas" FontSize="12" BorderThickness="0" TextChanged="ConnectionLog_TextChanged" />
                        <Button Grid.Row="2" Content="重试连接" Command="{Binding ConnectCommand}" HorizontalAlignment="Left" Margin="6,8,6,4" />
                    </Grid>
                </Grid>
            </Border>
            <Popup x:Name="DockHint" Placement="Relative" PlacementTarget="{Binding ElementName=DockLayout}" AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="False">
                <Border Height="76" Background="#E0143B3C" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="5"><TextBlock Text="松开鼠标，合并到终端底部" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Popup>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,7">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="{Binding IsConnected, Converter={StaticResource BooleanVisibility}}" /><Style.Triggers><DataTrigger Binding="{Binding IsTerminalFullscreen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><DockPanel><TextBlock Text="CPU" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding CpuLabel}" HorizontalAlignment="Right" FontFamily="Consolas" /></DockPanel><ProgressBar x:Name="CpuProgress" Value="{Binding CpuPercent, Mode=OneWay, TargetNullValue=0}" Maximum="100" Height="4" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0"><DockPanel><TextBlock Text="内存" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding MemoryLabel}" HorizontalAlignment="Right" FontFamily="Consolas" /></DockPanel><ProgressBar x:Name="MemoryProgress" Value="{Binding MemoryPercent, Mode=OneWay, TargetNullValue=0}" Maximum="100" Height="4" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0" ToolTip="{Binding LoadTooltip}"><DockPanel><TextBlock Text="负载" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding LoadPercentLabel}" HorizontalAlignment="Right" FontFamily="Consolas" /></DockPanel><ProgressBar x:Name="LoadProgress" Value="{Binding LoadPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,16,0" ToolTip="网卡累计接收 / 发送流量（不含回环接口）"><TextBlock Text="网络累计" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding NetworkLabel}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="{Binding Uptime, StringFormat=运行时间 {0}}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding PerformanceSource}" ToolTip="{Binding PerformanceSource}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                <local:NetworkStatusIndicator Grid.Column="5" DataContext="{Binding NetworkStatus}" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
