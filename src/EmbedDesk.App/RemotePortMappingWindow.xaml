<Window x:Class="EmbedDesk.App.RemotePortMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加端口映射" Width="620" Height="550" MinWidth="540" MinHeight="510" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="将本机端口映射到对端目标" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="对端发布的 TCP / UDP 目标"/>
                <ComboBox x:Name="ServiceBox" TextSearch.TextPath="DisplayName" SelectionChanged="Service_Changed" Margin="0,6,0,8">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="EmptyServicesHint" Text="暂无可用目标。请先连接设备，由对端发布 TCP 或 UDP 服务后重新添加。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
                <TextBlock x:Name="ProtocolLabel" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
                <TextBlock Text="本机映射端口（仅限 127.0.0.1）"/>
                <Grid Margin="0,6,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10"><TextBlock Text="127.0.0.1" VerticalAlignment="Center"/></Border>
                    <TextBox x:Name="LocalPort" Grid.Column="2" MaxLength="5" TextChanged="Port_Changed" AutomationProperties.Name="本机映射端口"/>
                </Grid>
                <TextBlock x:Name="ValidationText" Foreground="#FFB4A5" MinHeight="22" TextWrapping="Wrap"/>
                <TextBlock Text="本机软件连接此回环地址即可访问对端发布的目标。传输协议随所选目标固定。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="映射预览" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                <TextBlock x:Name="MappingPreview" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#FFB4A5" TextWrapping="Wrap" MinHeight="22" MaxHeight="64" ToolTip="{Binding Text, ElementName=ErrorText}" Margin="0,10,0,8"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True"/>
            <Button x:Name="SavePortButton" Content="保存并启用映射" IsDefault="True" Click="Save_Click" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
