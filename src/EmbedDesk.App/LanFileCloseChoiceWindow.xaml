<Window x:Class="EmbedDesk.App.LanFileCloseChoiceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭文件分享" Width="520" Height="230" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="是否在后台保留文件服务和传输任务？" FontSize="15" TextWrapping="Wrap"/>
   <TextBlock Text="后台保留后，再次打开局域网文件会恢复原窗口；退出 EmbedDesk 时统一停止。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
   <Button x:Name="StopButton" Content="停止并关闭" Click="Stop_Click" Margin="0,0,8,0"/>
   <Button x:Name="KeepButton" Content="后台保留" Click="Keep_Click" Style="{StaticResource PrimaryButton}"/>
  </StackPanel>
 </Grid>
</Window>
