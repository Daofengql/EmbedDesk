<Window x:Class="EmbedDesk.App.BinaryEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbedDesk.App.Controls"
 Title="二进制编辑器" Icon="Assets/embeddesk.ico" Width="1120" Height="820" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="7,4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="7,4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="HexScroll" TargetType="ScrollBar"><Setter Property="Width" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{StaticResource InputBrush}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{StaticResource LineBrush}" CornerRadius="4" Margin="3,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="二进制编辑器" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="点选字节直接编辑 · Tab 切换 HEX / ASCII" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/></Grid>
  <WrapPanel x:Name="Toolbar" Grid.Row="1" Margin="0,0,0,10">
   <Button Content="打开文件" Click="Open_Click" Margin="0,0,6,0"/><Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsEnabled="False" Margin="0,0,6,0"/><Button x:Name="SaveAsButton" Content="另存为" Click="SaveAs_Click" IsEnabled="False" Margin="0,0,14,0"/>
   <Button x:Name="UndoButton" Content="撤销" Click="Undo_Click" IsEnabled="False" Margin="0,0,6,0"/><Button x:Name="RedoButton" Content="重做" Click="Redo_Click" IsEnabled="False" Margin="0,0,16,0"/><TextBlock x:Name="FileText" Text="未打开文件" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
  </WrapPanel>
  <WrapPanel x:Name="SearchPanel" Grid.Row="2" Margin="0,0,0,10" IsEnabled="False">
   <TextBlock Text="地址 (HEX)" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="GotoBox" Text="0" Width="110" FontFamily="Consolas" Margin="0,0,6,0"/><Button Content="定位" Click="Goto_Click" Margin="0,0,20,0"/>
   <ComboBox x:Name="SearchModeBox" Width="110" SelectedIndex="0" Margin="0,0,6,0"><ComboBoxItem Content="HEX 搜索"/><ComboBoxItem Content="UTF-8 搜索"/></ComboBox><TextBox x:Name="SearchBox" Width="220" FontFamily="Consolas" Margin="0,0,6,0"/><Button Content="查找下一个" Click="Find_Click"/>
  </WrapPanel>
  <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><local:HexEditorView x:Name="HexView"/><ScrollBar x:Name="FileScroll" Grid.Column="1" Style="{StaticResource HexScroll}" Minimum="0" SmallChange="1" ValueChanged="Scroll_Changed"/></Grid></Border>
  <Grid Grid.Row="4" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionText" Text="偏移 —" FontFamily="Consolas" FontSize="12" Style="{StaticResource MutedText}"/><TextBlock x:Name="LengthText" Grid.Column="1" Text="0 字节" FontSize="12" Style="{StaticResource MutedText}"/></Grid>
  <DockPanel Grid.Row="5" Margin="0,8,0,0"><Button x:Name="CancelButton" Content="取消操作" Click="Cancel_Click" DockPanel.Dock="Right" Visibility="Collapsed" Margin="8,0,0,0"/><TextBlock x:Name="StatusText" Text="覆盖模式 · 输入两个十六进制数字修改一个字节 · Ctrl+Z 撤销 / Ctrl+Y 重做" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
