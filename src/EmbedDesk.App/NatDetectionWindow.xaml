<Window x:Class="EmbedDesk.App.NatDetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STUN / NAT 检测" Icon="Assets/embeddesk.ico" Width="920" Height="800" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="STUN / NAT 检测" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="按相同公网出口 IP 分组，分别比较映射端口与入站过滤行为，判断 IPv4 NAT 类型。" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Expander x:Name="ServerSettings" Header="STUN 节点 · 展开编辑" VerticalAlignment="Top" Padding="0,7,0,0" FontSize="12">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="每行一个，也可用分号分隔" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" />
                    <TextBox x:Name="ServersBox" Height="100" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </StackPanel>
            </Expander>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button x:Name="StartButton" Content="检测" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="2" x:Name="ReportScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="NatTypeText" Text="未检测 / Not tested" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <ItemsControl x:Name="ExitReports" ItemsSource="{Binding Exits}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid>
                                        <UniformGrid.Style>
                                            <Style TargetType="UniformGrid">
                                                <Setter Property="Columns" Value="2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Exits.Count}" Value="1"><Setter Property="Columns" Value="1" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UniformGrid.Style>
                                    </UniformGrid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,8,0" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding MappingDetails}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Evidence}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                                            <Expander Header="参与节点与本地地址" FontSize="11" Margin="0,7,0,0">
                                                <StackPanel Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding NodesText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding LocalDetails}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Results}" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeRows="False" RowHeight="28" MinRowHeight="28"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STUN 节点" Binding="{Binding Server}" Width="240" />
                        <DataGridTextColumn Header="公网映射" Binding="{Binding MappedEndpoint}" Width="165" />
                        <DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="85" />
                        <DataGridTextColumn Header="检测详情" Binding="{Binding Detail}" Width="*" MinWidth="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="公共节点可用性因网络而异；证据不足时保留未确定结论。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
    </Grid>
</Window>
