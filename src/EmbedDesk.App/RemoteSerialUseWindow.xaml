<Window x:Class="EmbedDesk.App.RemoteSerialUseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加串口映射" Width="620" Height="640" MinWidth="560" MinHeight="580" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="选择对端串口和使用方式" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="对端发布的串口"/>
                <ComboBox x:Name="ServiceBox" TextSearch.TextPath="DisplayName" SelectionChanged="Service_Changed" Margin="0,6,0,12">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="EmptyServicesHint" Text="暂无可用串口。请先连接设备，由对端发布串口后重新添加。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
                <TextBlock Text="使用方式"/>
                <ComboBox x:Name="UsageMode" SelectedIndex="0" SelectionChanged="Mode_Changed" Margin="0,6,0,16">
                    <ComboBoxItem Content="在本软件内使用"/>
                    <ComboBoxItem Content="映射为系统虚拟 COM（实验性）"/>
                </ComboBox>
                <TextBlock x:Name="AppHint" Text="在串口调试中打开一个远程串口标签，设置参数后连接。无需虚拟串口驱动。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <StackPanel x:Name="VirtualFields" Visibility="Collapsed">
                    <TextBlock Text="本机虚拟串口对"/>
                    <Grid Margin="0,6,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="PairBox" DisplayMemberPath="DisplayName" SelectionChanged="Pair_Changed" Margin="0,0,10,0"/>
                        <Button x:Name="RefreshPairsButton" Grid.Column="1" Content="刷新" Click="Refresh_Click"/>
                    </Grid>
                    <TextBlock x:Name="DriverStatus" Foreground="#FFB4A5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="左侧 COM 供其他软件打开，右侧由 EmbedDesk 占用。先在 com0com 中创建串口对，并为桥接端设置 dcd=ropen、cts=rrts、dsr=rdtr。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="外部软件打开时才打开远端设备，关闭后释放。同步串口参数和 DTR/RTS；暂不支持 Break 与远端硬件流控。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="映射预览" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                <TextBlock x:Name="MappingPreview" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#FFB4A5" TextWrapping="Wrap" MinHeight="22" MaxHeight="64" ToolTip="{Binding Text, ElementName=ErrorText}" Margin="0,10,0,8"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True"/>
            <Button x:Name="UseSerialButton" Content="进入串口调试" IsDefault="True" Click="Use_Click" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
