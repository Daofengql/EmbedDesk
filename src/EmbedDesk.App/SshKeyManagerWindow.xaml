<Window x:Class="EmbedDesk.App.SshKeyManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SSH 密钥管理器" Icon="Assets/embeddesk.ico" Width="620" Height="420" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="SSH 密钥管理器" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="管理本机私钥文件，连接配置可以直接引用。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,16" /></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding SshKeys}" SelectedItem="{Binding SelectedKey, Mode=TwoWay}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" /><TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="添加私钥" Click="Add_Click" Margin="0,0,8,0" /><Button Content="移除" Click="Remove_Click" Margin="0,0,8,0" /><Button Content="完成" Style="{StaticResource PrimaryButton}" Click="Close_Click" /></StackPanel></Grid>
</Window>
