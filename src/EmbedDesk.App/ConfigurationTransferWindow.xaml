<Window x:Class="EmbedDesk.App.ConfigurationTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置导入 / 导出" Icon="Assets/embeddesk.ico"
        Width="650" Height="430" MinWidth="580" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="配置导入 / 导出" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="迁移不含密码、私钥、S3 / STCP 密钥或活动会话的命名连接配置。导入同名配置时保留本机版本。" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,18" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="16">
            <StackPanel>
                <TextBlock Text="包含内容" FontWeight="SemiBold" />
                <TextBlock Text="远程调试连接（SSH / Telnet / RDP / VNC / S3）、网络串口预设和 STCP 隧道参数。" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="导入时会重新生成本机配置编号；密码、私钥口令、密钥内容和凭据管理器索引不会随文件传输。STCP 配置导入后需要重新设置共享密钥。" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="导入配置…" Click="Import_Click" Margin="0,0,8,0" />
            <Button Content="导出配置…" Click="Export_Click" Margin="0,0,8,0" />
            <Button Content="关闭" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
