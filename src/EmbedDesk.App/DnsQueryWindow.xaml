<Window x:Class="EmbedDesk.App.DnsQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS 查询" Icon="Assets/embeddesk.ico" Width="1000" Height="720" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="ResultValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="ResultName" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DNS 查询" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="UDP / TCP / DoH，查看记录、TTL 与完整响应。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button x:Name="QueryButton" Content="查询" Style="{StaticResource PrimaryButton}" Click="Query_Click" />
                <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="8,0,0,0" />
                <Button x:Name="CopyButton" Content="复制结果" Click="Copy_Click" IsEnabled="False" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" x:Name="ParametersPanel" Margin="0,16,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="域名 / IP 地址（PTR 反向查询）" Style="{StaticResource FieldLabel}" /><TextBox x:Name="QueryBox" Text="example.com" FontFamily="Consolas" KeyDown="Query_KeyDown" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="记录类型 · 支持 TYPE数字" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="TypeBox" IsEditable="True" IsTextSearchEnabled="False" Padding="8,5,32,5" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="查询类" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ClassBox" /></StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="94" /><ColumnDefinition Width="180" /><ColumnDefinition Width="100" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock x:Name="ServerLabel" Text="DNS 服务器 · IPv4 / IPv6" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ServerBox" IsEditable="True" IsTextSearchEnabled="False" Padding="8,5,32,5" FontFamily="Consolas" /></StackPanel>
                <StackPanel x:Name="PortPanel" Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="端口" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PortBox" Text="53" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="传输协议" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="TransportBox" SelectionChanged="Transport_Changed" Padding="8,5,32,5"><ComboBoxItem Content="UDP · 截断转 TCP" /><ComboBoxItem Content="TCP" /><ComboBoxItem Content="DoH · HTTPS" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="单次超时 / ms" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TimeoutBox" Text="2000" /></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="重试次数" Style="{StaticResource FieldLabel}" /><TextBox x:Name="RetriesBox" Text="1" /></StackPanel>
            </Grid>
            <WrapPanel Margin="0,10,0,0">
                <CheckBox x:Name="RecursionBox" Content="请求递归（RD）" IsChecked="True" ToolTip="关闭后可查看权威服务器直接应答或委派信息。" />
                <TextBlock x:Name="TransportHint" Text="每次直接向所选服务器发起查询；不读取系统 DNS 缓存。" Style="{StaticResource MutedText}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center" />
            </WrapPanel>
        </StackPanel>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="ResponseText" Text="等待查询" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MetadataText" Text="自动模式：域名查询 A 记录，IP 地址查询 PTR 记录。" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <TabControl Grid.Row="3">
            <TabItem Header="记录">
                <DataGrid ItemsSource="{Binding Results}" IsReadOnly="True" CanUserResizeRows="False" AutoGenerateColumns="False" RowHeight="NaN" MinRowHeight="30" ClipboardCopyMode="IncludeHeader" SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="区段" Binding="{Binding Section}" Width="62" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="165" ElementStyle="{StaticResource ResultName}" />
                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="84" />
                        <DataGridTextColumn Header="类" Binding="{Binding Class}" Width="50" />
                        <DataGridTextColumn Header="TTL / 秒" Binding="{Binding Ttl}" Width="78" />
                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" MinWidth="250" ElementStyle="{StaticResource ResultValue}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="详细响应">
                <TextBox x:Name="DetailsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="4" x:Name="StatusText" Text="未开始" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
