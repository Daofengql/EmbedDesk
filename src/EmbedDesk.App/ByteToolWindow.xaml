<Window x:Class="EmbedDesk.App.ByteToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据工具" Icon="Assets/embeddesk.ico" Width="940" Height="730" MinWidth="780" MinHeight="620" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="1.4*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="DescriptionText" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" /></StackPanel>
        <WrapPanel x:Name="ParametersPanel" Grid.Row="1" Margin="0,16,0,12" VerticalAlignment="Center">
            <StackPanel Width="156" Margin="0,0,10,0"><TextBlock Text="输入格式" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="InputFormatBox" Padding="8,5,32,5" /></StackPanel>
            <StackPanel x:Name="OutputFormatPanel" Width="156" Margin="0,0,10,0"><TextBlock Text="输出格式" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="OutputFormatBox" Padding="8,5,32,5" /></StackPanel>
            <Button x:Name="LoadButton" Content="读取文件" Click="Load_Click" Margin="0,18,8,0" />
            <Button x:Name="ResetButton" Content="使用文本输入" Click="Reset_Click" Margin="0,18,8,0" Visibility="Collapsed" />
            <Button x:Name="RunButton" Content="转换" Style="{StaticResource PrimaryButton}" Click="Run_Click" Margin="0,18,0,0" />
        </WrapPanel>
        <TextBlock x:Name="InputLabel" Grid.Row="2" Text="输入 · 原样处理，保留空格和换行" FontSize="12" Margin="0,0,0,6" />
        <TextBox x:Name="InputBox" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" MaxLength="1048576" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" />
        <Grid Grid.Row="4" Margin="0,12,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="结果" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" x:Name="CopyButton" Content="复制结果" Click="Copy_Click" IsEnabled="False" />
        </Grid>
        <TextBox x:Name="OutputBox" Grid.Row="5" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
        <TextBlock x:Name="StatusText" Grid.Row="6" Text="未开始" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
    </Grid>
</Window>
