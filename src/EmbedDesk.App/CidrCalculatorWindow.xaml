<Window x:Class="EmbedDesk.App.CidrCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CIDR 计算" Icon="Assets/embeddesk.ico" Width="560" Height="590" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="CIDR 计算" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="输入 IPv4 或 IPv6 网段，查看地址范围和主机数量。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="InputBox" Text="192.168.1.0/24" FontFamily="Consolas" FontSize="15" Padding="10,7" KeyDown="Input_KeyDown" /><Button Grid.Column="1" Content="计算" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Calculate_Click" /></Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="地址族" Style="{StaticResource MutedText}" /><TextBlock x:Name="FamilyText" FontSize="15" Margin="0,5,0,18" /><TextBlock Text="前缀长度" Style="{StaticResource MutedText}" /><TextBlock x:Name="PrefixText" FontSize="15" Margin="0,5,0,18" /><TextBlock Text="可用主机" Style="{StaticResource MutedText}" /><TextBlock x:Name="HostCountText" FontSize="15" Margin="0,5,0,18" /></StackPanel>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="网络地址" Style="{StaticResource MutedText}" /><TextBlock x:Name="NetworkText" Grid.Row="1" FontFamily="Consolas" FontSize="14" Margin="0,5,0,14" />
                <TextBlock Text="子网掩码" Grid.Row="2" Style="{StaticResource MutedText}" /><TextBlock x:Name="MaskText" Grid.Row="3" FontFamily="Consolas" FontSize="14" Margin="0,5,0,14" />
                <TextBlock Text="广播地址 / IPv6 上界" Grid.Row="4" Style="{StaticResource MutedText}" /><TextBlock x:Name="BroadcastText" Grid.Row="5" FontFamily="Consolas" FontSize="14" Margin="0,5,0,14" />
                <TextBlock Text="首个主机" Grid.Row="6" Style="{StaticResource MutedText}" /><TextBlock x:Name="FirstText" Grid.Row="7" FontFamily="Consolas" FontSize="14" Margin="0,5,0,14" />
                <TextBlock Text="末个主机" Grid.Row="8" Style="{StaticResource MutedText}" /><TextBlock x:Name="LastText" Grid.Row="9" FontFamily="Consolas" FontSize="14" Margin="0,5,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
