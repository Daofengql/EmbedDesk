<Window x:Class="EmbedDesk.App.HostsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hosts 管理器" Icon="Assets/embeddesk.ico" Width="1000" Height="680"
        MinWidth="880" MinHeight="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <StackPanel><TextBlock Text="Hosts 管理器" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="按方案管理域名与 IP 映射 · 应用前自动备份系统 Hosts" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
        </Grid>
        <TabControl x:Name="ToolTabs" Grid.Row="1">
            <TabItem Header="方案与解析规则">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProfileBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" ToolTip="方案名称" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="新建方案" Click="AddProfile_Click"/><Button Content="删除方案" Click="DeleteProfile_Click" Margin="6,0,0,0"/></StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="AddRuleButton" Content="添加规则" Click="AddRule_Click"/>
                            <Button Content="删除所选" Click="DeleteRule_Click" Margin="6,0,0,0"/>
                            <Button x:Name="SaveButton" Content="保存方案" Click="Save_Click" Margin="16,0,0,0"/>
                            <Button Content="导入 JSON" Click="Import_Click" Margin="6,0,0,0"/>
                            <Button Content="导出 JSON" Click="Export_Click" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="每条规则填写一个完整域名和 IPv4 / IPv6 地址；子域名需逐条添加，Hosts 不支持通配符。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,10"/>
                    <DataGrid x:Name="RulesGrid" Grid.Row="2" ItemsSource="{Binding SelectedProfile.Rules}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" MinHeight="110">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                            <DataGridTextColumn Header="域名" Binding="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="150"/>
                            <DataGridTextColumn Header="IPv4 / IPv6" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="160"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                        <Button x:Name="ApplyHostsButton" Content="应用 Hosts…" Click="ApplyHosts_Click" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="移除本工具的 Hosts 映射…" Click="RemoveHosts_Click" Margin="8,0,0,0"/>
                        <Button Content="刷新 DNS 缓存" Click="Flush_Click" Margin="8,0,0,0"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="系统 Hosts 与备份">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="HostsPathText" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <WrapPanel Grid.Row="1" Margin="0,10,0,10"><Button Content="重新读取" Click="ReloadHosts_Click"/><Button Content="恢复备份…" Click="Restore_Click" Margin="8,0,0,0"/><TextBlock Text="每次写入自动备份完整文件；恢复前也会备份。" Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center"/></WrapPanel>
                    <TextBox x:Name="SystemHostsBox" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10,0,0" MaxHeight="70" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
    </Grid>
</Window>
