<Window x:Class="EmbedDesk.App.ConfigurationImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览导入配置" Icon="Assets/embeddesk.ico"
        Width="620" Height="560" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="导入内容预览" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" />
        </StackPanel>
        <TextBox x:Name="PreviewText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Padding="10" />
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="密码、私钥路径 / 口令、S3 凭据和 STCP 共享密钥不会导入；同名配置保留本机版本。" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
                <Button Content="确认导入" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="90" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
