<Window x:Class="EmbedDesk.App.NetworkConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建网络会话" Icon="Assets/embeddesk.ico" Width="560" Height="780" MinHeight="700" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="新建网络会话" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="设置连接端点，收发内容和发送任务在工作区中管理。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="协议" Margin="0,0,0,6" Style="{StaticResource MutedText}" /><ComboBox x:Name="ProtocolBox" SelectedIndex="0" SelectionChanged="OptionsChanged"><ComboBoxItem Content="TCP" /><ComboBoxItem Content="UDP" /><ComboBoxItem Content="MQTT" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="模式" Margin="0,0,0,6" Style="{StaticResource MutedText}" /><ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="OptionsChanged"><ComboBoxItem Content="客户端" /><ComboBoxItem Content="服务端" /></ComboBox></StackPanel>
            </Grid>
            <StackPanel x:Name="ServerFields">
                <TextBlock Text="监听地址" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><ComboBox x:Name="LocalAddressBox" DisplayMemberPath="Label" SelectionChanged="ListenAddressChanged" ToolTip="选择网卡地址、环回、所有网卡或自定义地址" /><TextBox Grid.Column="2" x:Name="LocalPortBox" Text="9000" ToolTip="监听端口" /></Grid>
                <TextBox x:Name="CustomLocalAddressBox" Visibility="Collapsed" Margin="0,8,0,0" ToolTip="输入要绑定的本机 IP 地址" />
                <TextBlock Text="环回仅允许本机访问；所有网卡会绑定到所有接口。防火墙和路由仍会影响远端连通。" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,18" />
            </StackPanel>
            <StackPanel x:Name="ClientFields">
                <TextBlock Text="远程地址" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBox x:Name="RemoteHostBox" Text="127.0.0.1" ToolTip="目标 IP 或域名" /><TextBox Grid.Column="2" x:Name="RemotePortBox" Text="9000" ToolTip="目标端口" /></Grid>
                <StackPanel x:Name="ClientSourcePanel" Margin="0,12,0,0"><TextBlock Text="本地出口地址" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="ClientSourceAddressBox" DisplayMemberPath="Label" ToolTip="自动选择使用系统路由；也可以绑定到某个本机网卡地址" /><TextBlock Text="自动选择使用系统路由表；指定地址后，系统会使用对应网卡连接目标。" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                <TextBlock Text="客户端会连接此地址；本地端口由系统自动分配。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,18" />
            </StackPanel>
            <StackPanel x:Name="MqttFields" Visibility="Collapsed" Margin="0,18,0,0"><TextBlock Text="订阅 / 发布主题" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBox x:Name="MqttTopicBox" Text="embeddesk" ToolTip="MQTT 客户端连接后订阅并发布到此主题" /><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="用户名（可选）" Style="{StaticResource MutedText}" Margin="0,0,0,6" /><TextBox x:Name="MqttUsernameBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="密码（可选）" Style="{StaticResource MutedText}" Margin="0,0,0,6" /><PasswordBox x:Name="MqttPasswordBox" /></StackPanel></Grid><CheckBox x:Name="MqttTlsBox" Content="使用 TLS（通常为 8883 端口）" Margin="0,14,0,0" /><TextBlock Text="当前收发区使用同一个主题，支持普通 MQTT broker 回环调试。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" /></StackPanel>
            <StackPanel Margin="0,20,0,0"><CheckBox x:Name="ReconnectBox" Content="连接中断后自动重连" IsChecked="True" Margin="0,0,0,12" /><CheckBox x:Name="HttpBox" Content="启用 HTTP 诊断" /><TextBlock x:Name="HttpHint" Text="TCP 服务端启用后会自动回复 HTTP 200。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" /></StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#F0A4A4" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,8,0" /><Button Content="创建并启动" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Create_Click" /></StackPanel>
    </Grid>
</Window>
