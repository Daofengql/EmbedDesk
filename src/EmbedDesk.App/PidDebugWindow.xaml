<Window x:Class="EmbedDesk.App.PidDebugWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EmbedDesk.App.Controls"
 Title="PID 调试助手" Icon="Assets/embeddesk.ico" Width="1160" Height="860" MinWidth="1000" MinHeight="780" FontSize="12" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="7,4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="7,4"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PID 调试助手" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="五通道实时曲线 · 参数下发与平滑滤波" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="连接设置" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <local:DebugToolConnectionPanel x:Name="Connection"/>
     <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12"/>
     <TextBlock Text="PID 参数" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="选择通道" VerticalAlignment="Center"/><ComboBox x:Name="ChannelBox" Grid.Column="1" SelectionChanged="Channel_Changed"/></Grid>
     <StackPanel x:Name="EditorPanel" Margin="0,8,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="P" VerticalAlignment="Center"/><TextBox x:Name="PBox" Grid.Column="1" Text="1" Margin="0,0,0,4"/>
       <TextBlock Grid.Row="1" Text="I" VerticalAlignment="Center"/><TextBox x:Name="IBox" Grid.Row="1" Grid.Column="1" Text="0" Margin="0,0,0,4"/>
       <TextBlock Grid.Row="2" Text="D" VerticalAlignment="Center"/><TextBox x:Name="DBox" Grid.Row="2" Grid.Column="1" Text="0"/>
      </Grid>
      <Button Content="发送 PID" Tag="16" Click="Send_Click" Margin="62,6,0,0"/>
      <TextBlock Text="目标值 · Int32" Style="{StaticResource MutedText}" Margin="0,10,0,4"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TargetBox" Text="0" Margin="0,0,6,0"/><Button Grid.Column="1" Content="发送目标值" Tag="17" Click="Send_Click" Padding="8,4"/></Grid>
      <TextBlock Text="周期 · UInt32，单位由固件决定" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,4"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PeriodBox" Text="200" Margin="0,0,6,0"/><Button Grid.Column="1" Content="发送周期" Tag="21" Click="Send_Click" Padding="8,4"/></Grid>
      <UniformGrid Columns="3" Margin="0,12,0,0"><Button Content="启动" Tag="18" Click="Send_Click" Margin="0,0,4,0"/><Button Content="停止" Tag="19" Click="Send_Click" Margin="0,0,4,0"/><Button Content="复位" Tag="20" Click="Send_Click"/></UniformGrid>
     </StackPanel>
     <TextBlock x:Name="ChannelStatus" Text="实际值：—&#10;设备状态：未同步" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True"><local:PidPlot x:Name="Plot"/></Border>
    <WrapPanel x:Name="Legend" Grid.Row="1" Margin="0,10,0,0"><CheckBox Content="CH1" Foreground="#4CC9B0" IsChecked="True" Margin="0,0,14,0"/><CheckBox Content="CH2" Foreground="#E5C777" IsChecked="True" Margin="0,0,14,0"/><CheckBox Content="CH3" Foreground="#E8887A" IsChecked="True" Margin="0,0,14,0"/><CheckBox Content="CH4" Foreground="#6BB7DC" IsChecked="True" Margin="0,0,14,0"/><CheckBox Content="CH5" Foreground="#BC94D9" IsChecked="True"/><CheckBox x:Name="ShowTargetBox" Content="目标值（虚线）" IsChecked="True" Margin="18,0,0,0"/></WrapPanel>
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
     <WrapPanel Margin="0,0,0,7">
      <TextBlock Text="时间窗" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="TimeWindowBox" Width="82" SelectedIndex="7" SelectionChanged="TimeWindow_Changed" ToolTip="预设时间窗；也可在曲线上滚轮缩放" Margin="0,0,12,0"><ComboBoxItem Content="50 ms" Tag="0.05"/><ComboBoxItem Content="100 ms" Tag="0.1"/><ComboBoxItem Content="250 ms" Tag="0.25"/><ComboBoxItem Content="500 ms" Tag="0.5"/><ComboBoxItem Content="1 s" Tag="1"/><ComboBoxItem Content="2 s" Tag="2"/><ComboBoxItem Content="5 s" Tag="5"/><ComboBoxItem Content="10 s" Tag="10"/><ComboBoxItem Content="30 s" Tag="30"/><ComboBoxItem Content="60 s" Tag="60"/><ComboBoxItem Content="120 s" Tag="120"/><ComboBoxItem Content="600 s" Tag="600"/></ComboBox>
      <TextBlock Text="滤波" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="FilterBox" Width="112" SelectedIndex="0" SelectionChanged="PlotSettings_Changed" Margin="0,0,8,0"><ComboBoxItem Content="关闭"/><ComboBoxItem Content="移动平均"/><ComboBoxItem Content="指数平滑"/></ComboBox>
      <StackPanel x:Name="AverageSettings" Orientation="Horizontal" Margin="0,0,12,0"><TextBlock Text="窗口 N" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="SmoothingWindowBox" Text="5" Width="48" ToolTip="1–1000 个采样；窗口越大，曲线越平滑、滞后越明显" TextChanged="PlotSettings_TextChanged"/></StackPanel>
      <StackPanel x:Name="ExponentialSettings" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0"><TextBlock Text="α" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="SmoothingAlphaBox" Text="0.30" Width="58" ToolTip="0 &lt; α ≤ 1；数值越小，曲线越平滑、滞后越明显" TextChanged="PlotSettings_TextChanged"/></StackPanel>
      <CheckBox x:Name="ShowPointsBox" Content="显示采样点" VerticalAlignment="Center" Checked="PlotSettings_Changed" Unchecked="PlotSettings_Changed"/>
     </WrapPanel>
     <WrapPanel><Button Content="清空曲线" Click="Clear_Click" Margin="0,0,8,0"/><Button x:Name="ExportButton" Content="导出 CSV" Click="Export_Click" Margin="0,0,8,0"/><CheckBox x:Name="ExportFilteredBox" Content="附加滤波列" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="始终保留原始 actual 列，另加 filtered_actual；包含所有通道的保留采样"/><CheckBox x:Name="PauseBox" Content="暂停显示" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="重置时间轴" Click="ResetZoom_Click"/></WrapPanel>
     <DockPanel Margin="0,7,0,0"><Button x:Name="CancelExportButton" Content="取消导出" DockPanel.Dock="Right" Click="CancelExport_Click" Visibility="Collapsed"/><TextBlock x:Name="FilterHint" Text="滤波仅影响显示，保留原始采样。" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
     <TextBlock x:Name="InspectionText" Text="移动鼠标查看时间、原始值与显示值 · 滚轮缩放" Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="11" Height="16" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
     <TextBlock x:Name="MetricsText" Text="累计采样 0" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="每通道保留最近 2,000 个实际值采样；暂停显示期间继续接收。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid>
</Window>
