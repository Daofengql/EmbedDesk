<Window x:Class="EmbeddedDebugger.App.TcpPortCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="端口扫描" Icon="Assets/embedded-debugger.ico" Width="960" Height="670" MinWidth="800" MinHeight="540" WindowStartupLocation="CenterOwner">
    <Window.Resources><Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,0,5" /></Style></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="端口扫描" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="扫描单台设备的 TCP 端口；逐个地址显示握手结果。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="StartButton" Content="扫描" Style="{StaticResource PrimaryButton}" Click="Start_Click" /><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="8,0,0,0" /><Button x:Name="CopyButton" Content="复制结果" Click="Copy_Click" IsEnabled="False" Margin="8,0,0,0" /></StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" x:Name="ParametersPanel" Margin="0,16,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="目标主机 / IP 地址" Style="{StaticResource Label}" /><TextBox x:Name="HostBox" Text="127.0.0.1" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="端口 · 支持逗号与范围，每次最多 1024 个" Style="{StaticResource Label}" /><TextBox x:Name="PortsBox" Text="22,80,443,3389,5900,8080" /></StackPanel>
            </Grid>
            <WrapPanel Margin="0,10,0,0">
                <StackPanel Width="140" Margin="0,0,10,0"><TextBlock Text="地址协议" Style="{StaticResource Label}" /><ComboBox x:Name="FamilyBox" SelectedIndex="0" Padding="8,5,32,5"><ComboBoxItem Content="IPv4 + IPv6" /><ComboBoxItem Content="IPv4" /><ComboBoxItem Content="IPv6" /></ComboBox></StackPanel>
                <StackPanel Width="110" Margin="0,0,10,0"><TextBlock Text="单次超时 / ms" Style="{StaticResource Label}" /><TextBox x:Name="TimeoutBox" Text="3000" /></StackPanel>
                <StackPanel Width="90"><TextBlock Text="并发连接" Style="{StaticResource Label}" /><TextBox x:Name="ConcurrencyBox" Text="16" /></StackPanel>
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="SummaryText" Grid.Row="2" Text="等待扫描" FontWeight="SemiBold" Margin="0,0,0,10" />
        <DataGrid Grid.Row="3" ItemsSource="{Binding Results}" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeRows="False" RowHeight="30" ClipboardCopyMode="IncludeHeader">
            <DataGrid.Columns><DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="180" /><DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="70" /><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70" /><DataGridTextColumn Header="耗时 / ms" Binding="{Binding ElapsedMilliseconds, StringFormat=F1}" Width="90" /><DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" MinWidth="230" /></DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" x:Name="StatusText" Text="仅建立 TCP 连接，不发送应用层数据；结果列表只显示开放端口。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
    </Grid>
</Window>
