<Window x:Class="EmbeddedDebugger.App.NatDetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STUN / NAT 检测" Icon="Assets/embedded-debugger.ico" Width="760" Height="560" MinWidth="680" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="STUN / NAT 检测" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="向多个 STUN 服务发送标准 Binding Request，比较公网映射地址和端口。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ServersBox" Text="stun.l.google.com:19302;stun.cloudflare.com:3478" ToolTip="多个服务器用分号分隔" /><Button Grid.Column="1" Content="检测" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="10,0,8,0" /><Button Grid.Column="2" x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" /></Grid>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" CornerRadius="4"><StackPanel><TextBlock Text="NAT 判断" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock x:Name="NatTypeText" Text="未检测" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="SummaryText" Text="" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel></Border><ListView Grid.Row="1" ItemsSource="{Binding Results}" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" Margin="0,12,0,0"><ListView.View><GridView><GridViewColumn Header="STUN 服务" DisplayMemberBinding="{Binding Server}" Width="260" /><GridViewColumn Header="公网映射" DisplayMemberBinding="{Binding MappedEndpoint}" Width="180" /><GridViewColumn Header="延迟" DisplayMemberBinding="{Binding Latency}" Width="100" /><GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="140" /></GridView></ListView.View></ListView></Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="未开始" Style="{StaticResource MutedText}" /></Grid>
    </Grid>
</Window>
