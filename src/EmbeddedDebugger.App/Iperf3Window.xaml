<Window x:Class="EmbeddedDebugger.App.Iperf3Window" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="iperf3 吞吐测试" Icon="Assets/embedded-debugger.ico" Width="900" Height="660" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterOwner">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="iperf3 吞吐测试" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="内置 iperf3 TCP 协议 · 单连接流 · 正向 / 反向 · 实时速率与两端统计" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,18,0,12">
<StackPanel Width="105" Margin="0,0,10,8"><TextBlock Text="模式" Style="{StaticResource MutedText}"/><ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed"><ComboBoxItem Content="客户端"/><ComboBoxItem Content="服务端"/></ComboBox></StackPanel>
<StackPanel Width="205" Margin="0,0,10,8"><TextBlock x:Name="HostLabel" Text="远程地址" Style="{StaticResource MutedText}"/><TextBox x:Name="HostBox" Text="127.0.0.1"/></StackPanel>
<StackPanel Width="75" Margin="0,0,10,8"><TextBlock Text="TCP 端口" Style="{StaticResource MutedText}"/><TextBox x:Name="PortBox" Text="5201"/></StackPanel>
<StackPanel Width="85" Margin="0,0,10,8"><TextBlock Text="时长（秒）" Style="{StaticResource MutedText}"/><TextBox x:Name="DurationBox" Text="10"/></StackPanel>
<CheckBox x:Name="ReverseBox" Content="反向（下载）" VerticalAlignment="Bottom" Margin="0,0,12,16"/>
<Button x:Name="StartButton" Content="开始" Style="{StaticResource PrimaryButton}" Click="Start_Click" VerticalAlignment="Bottom" Margin="0,0,8,8"/><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
</WrapPanel>
<TextBox Grid.Row="2" x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" Padding="12" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}"/>
<StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="未开始" Style="{StaticResource MutedText}" TextWrapping="Wrap"/><TextBlock Text="对端使用 iperf3 -s 或 iperf3 -c 地址 -t 秒 [-R]。当前支持 TCP、-P 1、-O 0、按时长不限速测试。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
</Grid></Window>
