<Window x:Class="EmbeddedDebugger.App.TrafficRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志与回放" Icon="Assets/embedded-debugger.ico" Width="980" Height="690" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="110" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="日志与回放" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="保留串口 / 网络收发的原始字节、方向与时间。实时录制上限 64 MiB；导出历史受会话缓存范围限制。" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceBox" DisplayMemberPath="Label" SelectionChanged="Source_Changed" />
            <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新会话" Click="Refresh_Click" Margin="8,0,0,0" />
            <Button Grid.Column="2" x:Name="RecordButton" Content="开始录制" Click="Record_Click" Margin="8,0,0,0" />
            <Button Grid.Column="3" x:Name="ExportButton" Content="导出已有历史" Click="Export_Click" Margin="8,0,0,0" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" Content="打开录制" Click="Open_Click" />
            <TextBlock Grid.Column="1" Text="速度" VerticalAlignment="Center" Margin="12,0,6,0" Style="{StaticResource MutedText}" />
            <ComboBox x:Name="SpeedBox" Grid.Column="2" Width="85" SelectedIndex="2"><ComboBoxItem Content="0.25×" Tag="0.25" /><ComboBoxItem Content="0.5×" Tag="0.5" /><ComboBoxItem Content="1×" Tag="1" /><ComboBoxItem Content="2×" Tag="2" /><ComboBoxItem Content="4×" Tag="4" /><ComboBoxItem Content="8×" Tag="8" /></ComboBox>
            <CheckBox x:Name="SendCheck" Grid.Column="3" Content="将 TX 重发至所选串口" VerticalAlignment="Center" Margin="12,0,8,0" ToolTip="未勾选时只在窗口内回放；重发前会确认目标，RX 不会发出。" />
            <Button Grid.Column="4" x:Name="PlayButton" Content="回放" Click="Play_Click" />
            <Button Grid.Column="5" x:Name="StopButton" Content="停止" Click="Stop_Click" Margin="8,0,0,0" IsEnabled="False" />
        </Grid>
        <DataGrid x:Name="RecordsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Record_Changed" EnableRowVirtualization="True">
            <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="110" /><DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="55" /><DataGridTextColumn Header="字节" Binding="{Binding Count}" Width="80" /><DataGridTextColumn Header="文本预览（UTF-8）" Binding="{Binding Text}" Width="*" /></DataGrid.Columns>
        </DataGrid>
        <TextBox x:Name="RawBox" Grid.Row="4" Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
        <TextBlock x:Name="Status" Grid.Row="5" Text="选择会话开始录制，或打开 .edbgtrace 文件回放。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
</Window>
