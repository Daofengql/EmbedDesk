<Window x:Class="EmbeddedDebugger.App.NetworkTypeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择网络会话类型" Icon="Assets/embedded-debugger.ico" Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="选择网络会话类型" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="先选择协议，再设置客户端或服务端的连接端点。" Style="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,24,0,20">
            <Button Tag="Tcp" Click="Protocol_Click" Margin="0,0,8,0" Padding="14" VerticalContentAlignment="Center"><StackPanel VerticalAlignment="Center" TextBlock.TextAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="⇄" FontSize="24" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="TCP" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="可靠字节流" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel></Button>
            <Button Tag="Udp" Click="Protocol_Click" Margin="4,0" Padding="14" VerticalContentAlignment="Center"><StackPanel VerticalAlignment="Center" TextBlock.TextAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="◈" FontSize="24" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="UDP" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="无连接报文" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel></Button>
            <Button Tag="Mqtt" Click="Protocol_Click" Margin="8,0,0,0" Padding="14" VerticalContentAlignment="Center"><StackPanel VerticalAlignment="Center" TextBlock.TextAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="☁" FontSize="24" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="MQTT" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="消息代理" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel></Button>
        </UniformGrid>
        <Button Grid.Row="2" Content="取消" IsCancel="True" HorizontalAlignment="Right" MinWidth="72" />
    </Grid>
</Window>
