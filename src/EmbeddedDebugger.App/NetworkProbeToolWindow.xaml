<Window x:Class="EmbeddedDebugger.App.NetworkProbeToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ping / 路由追踪" Icon="Assets/embedded-debugger.ico" Width="900" Height="650" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Ping / 路由追踪" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="选择 ICMPing、TCPing 或 Traceroute，检查目标连通性、延迟和逐跳路径。" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="192" /><ColumnDefinition Width="*" /><ColumnDefinition Width="85" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="模式" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed"><ComboBoxItem Content="ICMPing" /><ComboBoxItem Content="TCPing" /><ComboBoxItem Content="路由追踪 / Traceroute" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="目标主机" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="HostBox" Text="127.0.0.1" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="TCP 端口" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="PortBox" Text="22" /></StackPanel>
                <Button Grid.Column="3" x:Name="StartButton" Content="开始" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="12,17,8,0" />
                <Button Grid.Column="4" x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="0,17,0,0" />
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="地址族" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="FamilyBox"><ComboBoxItem Content="自动选择" /><ComboBoxItem Content="仅 IPv4" /><ComboBoxItem Content="仅 IPv6" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock x:Name="InterfaceLabel" Text="网络出口" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="InterfaceBox" DisplayMemberPath="Name" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="包大小 / 字节" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="PacketSizeBox" Text="32" /></StackPanel>
            </Grid>
            <StackPanel x:Name="PingOptions" Orientation="Horizontal" Margin="0,12,0,0">
                <StackPanel Width="130"><TextBlock Text="循环次数 · 0 为持续" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="CountBox" Text="0" /></StackPanel>
                <StackPanel Width="130" Margin="10,0"><TextBlock Text="间隔 / 毫秒" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="IntervalBox" Text="1000" /></StackPanel>
            </StackPanel>
            <StackPanel x:Name="TraceOptions" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel Width="130"><TextBlock Text="最大跳数" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="MaxHopsBox" Text="30" /></StackPanel>
                <StackPanel Width="130" Margin="10,0"><TextBlock Text="每跳超时 / 毫秒" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="TimeoutBox" Text="1000" /></StackPanel>
                <CheckBox x:Name="ResolveNamesBox" Content="解析主机名" IsChecked="True" Margin="8,17,0,0" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2">
            <DataGrid x:Name="PingResults" ItemsSource="{Binding Samples}" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="120" /><DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="90" /><DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="100" /><DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" /></DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="TraceResults" ItemsSource="{Binding Hops}" Visibility="Collapsed" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns><DataGridTextColumn Header="跳数" Binding="{Binding Hop}" Width="55" /><DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="170" /><DataGridTextColumn Header="主机名" Binding="{Binding HostName}" Width="*" /><DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="100" /><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="125" /></DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="未开始" TextWrapping="Wrap" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="1" x:Name="SummaryText" Style="{StaticResource MutedText}" Margin="12,0,0,0" /></Grid>
    </Grid>
</Window>
