<Window x:Class="EmbeddedDebugger.App.NetworkProbeToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ping 网络探测" Icon="Assets/embedded-debugger.ico" Width="820" Height="620" MinWidth="760" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Ping 网络探测" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="ICMPing / TCPing 合并在同一个工具中，ICMP 参数接近系统 ping。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="95" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="模式" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed"><ComboBoxItem Content="ICMPing" /><ComboBoxItem Content="TCPing" /></ComboBox></StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock Text="目标主机" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="HostBox" Text="127.0.0.1" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="TCP 端口" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="PortBox" Text="22" /></StackPanel>
            <Button Grid.Column="3" x:Name="StartButton" Content="开始" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="12,17,8,0" />
            <Button Grid.Column="4" x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="0,17,0,0" />

            <StackPanel Grid.Row="1" Margin="0,12,10,0"><TextBlock Text="地址族" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="FamilyBox"><ComboBoxItem Content="自动选择" /><ComboBoxItem Content="仅 IPv4" /><ComboBoxItem Content="仅 IPv6" /></ComboBox></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,10,0"><TextBlock Text="网络出口" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><ComboBox x:Name="InterfaceBox" DisplayMemberPath="Name" /></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock Text="包大小 / 字节" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="PacketSizeBox" Text="32" /></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="3" Margin="12,12,8,0"><TextBlock Text="循环次数" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="CountBox" Text="0" ToolTip="0 表示持续运行" /></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0"><TextBlock Text="间隔 / 毫秒" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" /><TextBox x:Name="IntervalBox" Text="1000" /></StackPanel>
        </Grid>
        <ListView Grid.Row="2" ItemsSource="{Binding Samples}" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}">
            <ListView.View><GridView><GridViewColumn Header="时间" DisplayMemberBinding="{Binding Time}" Width="170" /><GridViewColumn Header="结果" DisplayMemberBinding="{Binding Outcome}" Width="100" /><GridViewColumn Header="延迟" DisplayMemberBinding="{Binding Latency}" Width="100" /><GridViewColumn Header="详情" DisplayMemberBinding="{Binding Detail}" Width="380" /></GridView></ListView.View>
        </ListView>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="未开始" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="1" x:Name="SummaryText" Text="" Style="{StaticResource MutedText}" /></Grid>
    </Grid>
</Window>
