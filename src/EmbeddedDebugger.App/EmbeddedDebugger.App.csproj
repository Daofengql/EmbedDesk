<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>EmbeddedDebugger.App</RootNamespace>
    <AssemblyName>EmbeddedDebugger.App</AssemblyName>
    <ApplicationIcon>Assets\embedded-debugger.ico</ApplicationIcon>
    <StartupObject>EmbeddedDebugger.App.Program</StartupObject>
    <PublishProfile Condition="'$(Configuration)' == 'Release' and '$(PublishProfile)' == ''">SingleFile</PublishProfile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EmbeddedDebugger.Core\EmbeddedDebugger.Core.csproj" />
    <ProjectReference Include="..\EmbeddedDebugger.Infrastructure\EmbeddedDebugger.Infrastructure.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\embedded-debugger.ico" />
    <Resource Include="Assets\Platforms\*.png" />
    <EmbeddedResource Include="Assets\Platforms\NOTICE.md;Assets\Platforms\LICENSE.devicon;Assets\Platforms\LICENSE.simple-icons.md" />
    <EmbeddedResource Include="Assets\Terminal\**\*" LogicalName="TerminalAssets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ExcludeSingleFileDevelopmentArtifacts" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' or ('%(ResolvedFileToPublish.Extension)' == '.xml' and $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('Microsoft.Web.WebView2')))" />
    </ItemGroup>
  </Target>
</Project>
