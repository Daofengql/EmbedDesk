<Window x:Class="EmbeddedDebugger.App.StcIspToolWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="C51 烧录工具 · STC89 ISP" Icon="Assets/embedded-debugger.ico" Width="960" Height="740" MinWidth="780" MinHeight="640" WindowStartupLocation="CenterOwner">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="C51 烧录工具 · STC89 ISP" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="内置 UART ISP · 自动识别芯片、擦除代码区、分块写入与设备校验" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
<WrapPanel Grid.Row="1" Margin="0,16,0,0">
<StackPanel Width="280" Margin="0,0,12,8"><TextBlock Text="物理串口 · RX/TX 交叉连接并共地" Style="{StaticResource MutedText}"/><ComboBox x:Name="PortBox"/></StackPanel>
<StackPanel Width="130" Margin="0,0,12,8"><TextBlock Text="握手波特率 · 8N1" Style="{StaticResource MutedText}"/><ComboBox x:Name="HandshakeBaudBox"/></StackPanel>
<StackPanel Width="140" Margin="0,0,12,8"><TextBlock Text="传输波特率" Style="{StaticResource MutedText}"/><ComboBox x:Name="TransferBaudBox"/></StackPanel>
<Button x:Name="RefreshButton" Content="刷新串口" Click="Refresh_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
</WrapPanel>
<WrapPanel Grid.Row="2" Margin="0,4,0,0">
<Button x:Name="ConnectButton" Content="连接 / 等待上电" Click="Connect_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
<Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click" IsEnabled="False" Margin="0,0,8,8"/>
<Button x:Name="ChooseButton" Content="选择固件" Click="Choose_Click" Margin="0,0,8,8"/>
<Button x:Name="EraseButton" Content="擦除代码区" Click="Erase_Click" IsEnabled="False" Margin="0,0,8,8"/>
<Button x:Name="WriteButton" Content="擦除并写入" Click="Write_Click" IsEnabled="False" Margin="0,0,8,8"/>
<Button x:Name="RunButton" Content="运行固件" Click="Run_Click" IsEnabled="False" Margin="0,0,8,8"/>
<Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" Margin="0,0,0,8"/>
</WrapPanel>
<Border Grid.Row="3" Padding="12" Margin="0,4,0,12" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"><StackPanel>
<TextBlock Text="连接后请给目标芯片断电再上电（等待 30 秒）。仅支持原始 STC89C / LE51、52、53、14 和 51RC、52RC、53RC、06RC、07RC、10RC、12RC；以读取到的芯片 ID 白名单为准。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
<TextBlock Text="STC8、STC15、STC12、STC89A 及其他厂商 C51 使用不同协议。写入保留原选项字节与 EEPROM；校验使用设备返回的分块校验和，此协议没有通用 Flash 回读命令。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
<TextBlock x:Name="DeviceText" Text="芯片：未连接" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
<TextBlock x:Name="FileText" Text="固件：未选择（支持 BIN / Intel HEX / S-Record，起始地址 0x0000）" TextWrapping="Wrap" Margin="0,6,0,0"/>
</StackPanel></Border>
<TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
<StackPanel Grid.Row="5" Margin="0,12,0,0"><ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100"/><TextBlock x:Name="Status" Text="选择串口后点击连接，再给目标上电。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
</Grid></Window>
