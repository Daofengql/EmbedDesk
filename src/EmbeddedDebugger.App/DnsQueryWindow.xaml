<Window x:Class="EmbeddedDebugger.App.DnsQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS 查询" Icon="Assets/embedded-debugger.ico" Width="820" Height="580" MinWidth="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="DNS 查询" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="使用系统 DNS 解析器执行正向或反向查询，查看地址族、主机名和响应延迟。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="Mode_Changed">
                <ComboBoxItem Content="正向解析（域名 → 地址）" />
                <ComboBoxItem Content="反向解析（地址 → 主机名）" />
            </ComboBox>
            <TextBox x:Name="QueryBox" Grid.Column="1" Text="example.com" Margin="10,0,10,0" FontFamily="Consolas" FontSize="14" Padding="9,6" KeyDown="Query_KeyDown" />
            <Button Grid.Column="2" x:Name="QueryButton" Content="查询" Style="{StaticResource PrimaryButton}" Click="Query_Click" />
        </Grid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" IsReadOnly="True" CanUserResizeRows="False" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="查询结果" Binding="{Binding Value}" Width="*" />
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="150" />
                <DataGridTextColumn Header="主机名" Binding="{Binding HostName}" Width="260" />
                <DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="100" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="未开始" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
    </Grid>
</Window>
