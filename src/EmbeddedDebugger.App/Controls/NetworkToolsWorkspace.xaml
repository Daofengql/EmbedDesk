<UserControl x:Class="EmbeddedDebugger.App.Controls.NetworkToolsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="22,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel><TextBlock Text="网络工具" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="地址规划、链路探测、NAT、DNS、UPnP 和路由诊断" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel Margin="22" HorizontalAlignment="Left">
                <Button Tag="Cidr" Click="OpenTool_Click" Width="190" Height="128" Margin="0,0,10,10" Padding="0" Background="{StaticResource SurfaceBrush}">
                    <StackPanel Margin="14"><TextBlock Text="⌘" FontSize="20" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="CIDR 计算" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="网络地址、掩码、广播地址和可用主机范围" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                </Button>
                <Button Tag="Ping" Click="OpenTool_Click" Width="190" Height="128" Margin="0,0,10,10" Padding="0" Background="{StaticResource SurfaceBrush}">
                    <StackPanel Margin="14"><TextBlock Text="◌" FontSize="20" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Ping / 路由追踪" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="ICMPing、TCPing 和逐跳路由追踪，支持地址族与网络出口" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                </Button>
                <Button Tag="Iperf3" Click="OpenTool_Click" Width="190" Height="128" Margin="0,0,10,10" Padding="0" Background="{StaticResource SurfaceBrush}">
                    <StackPanel Margin="14"><TextBlock Text="⚡" FontSize="20" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="iperf3" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="启动客户端或服务端进行吞吐量测试" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                </Button>
                <Button Tag="Discovery" Click="OpenTool_Click" Width="190" Height="128" Margin="0,0,10,10" Padding="0" Background="{StaticResource SurfaceBrush}">
                    <StackPanel Margin="14"><TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="内网扫描" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="轮询 Ping 并结合 ARP 查找在线设备和主机名" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                </Button>
                <Button Tag="Nat" Click="OpenTool_Click" Width="190" Height="128" Margin="0,0,10,10" Padding="0" Background="{StaticResource SurfaceBrush}">
                    <StackPanel Margin="14"><TextBlock Text="⇆" FontSize="20" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="STUN / NAT" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="检测公网映射地址并综合判断 NAT 类型" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                </Button>
                <Button Tag="Upnp" Click="OpenTool_Click" Width="190" Height="128" Margin="0,0,10,10" Padding="0" Background="{StaticResource SurfaceBrush}">
                    <StackPanel Margin="14"><TextBlock Text="▣" FontSize="20" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="UPnP 发现" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="发现路由器、网关和局域网 UPnP 设备" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                </Button>
                <Button Tag="Dns" Click="OpenTool_Click" Width="190" Height="128" Margin="0,0,10,10" Padding="0" Background="{StaticResource SurfaceBrush}">
                    <StackPanel Margin="14"><TextBlock Text="⌁" FontSize="20" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="DNS 查询" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="正向和反向解析，显示地址与主机名" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                </Button>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
