<UserControl x:Class="EmbeddedDebugger.App.Controls.ShellTerminal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="{StaticResource InputBrush}">
        <wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#20262C" />
        <TextBlock x:Name="ErrorText" Foreground="#F1B6B6" Margin="20" TextWrapping="Wrap" Visibility="Collapsed" />
    </Grid>
</UserControl>
