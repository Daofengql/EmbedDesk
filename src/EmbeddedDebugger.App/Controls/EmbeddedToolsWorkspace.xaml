<UserControl x:Class="EmbeddedDebugger.App.Controls.EmbeddedToolsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="EmbeddedCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="72" /><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectedBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="EmbeddedIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="FontSize" Value="18" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="16,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="嵌入式工具" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="按芯片烧录、介质写入和调试辅助功能分类" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" /></StackPanel></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,16">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,0,4,8" Margin="4,0,4,10"><TextBlock Text="芯片烧录工具" FontWeight="SemiBold" /></Border>
            <UniformGrid Columns="4">
                <Button Tag="EspConnect" Click="OpenTool_Click" Style="{StaticResource EmbeddedCard}" AutomationProperties.Name="ESP 烧录工具"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE950;" Style="{StaticResource EmbeddedIcon}" /><TextBlock Grid.Column="1" Text="ESP 烧录工具" FontWeight="SemiBold" /></Grid><TextBlock Text="ESP32 / ESP8266 ROM 烧录与串口监视器" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Button>
                <Button Tag="Firmware" Click="OpenTool_Click" Style="{StaticResource EmbeddedCard}" AutomationProperties.Name="STM32 烧录工具"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE896;" Style="{StaticResource EmbeddedIcon}" /><TextBlock Grid.Column="1" Text="STM32 烧录工具" FontWeight="SemiBold" /></Grid><TextBlock Text="USART、DTR/RTS、ST-LINK / DAPLink" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Button>
                <Button Tag="C51" Click="OpenTool_Click" Style="{StaticResource EmbeddedCard}" AutomationProperties.Name="C51 烧录工具"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE950;" Style="{StaticResource EmbeddedIcon}" /><TextBlock Grid.Column="1" Text="C51 烧录工具" FontWeight="SemiBold" /></Grid><TextBlock Text="STC89 UART ISP 识别、擦写与设备校验" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Button>
                <Button Tag="Ch347" Click="OpenTool_Click" Style="{StaticResource EmbeddedCard}" AutomationProperties.Name="CH347T 烧录工具"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE950;" Style="{StaticResource EmbeddedIcon}" /><TextBlock Grid.Column="1" Text="CH347T 烧录工具" FontWeight="SemiBold" /></Grid><TextBlock Text="HID · W25Q NOR / W25N01GV NAND 擦写" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Button>
            </UniformGrid>

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,0,4,8" Margin="4,22,4,10"><TextBlock Text="存储介质工具" FontWeight="SemiBold" /></Border>
            <UniformGrid Columns="3">
                <Button Tag="Image" Click="OpenTool_Click" Style="{StaticResource EmbeddedCard}" AutomationProperties.Name="SD / USB 镜像工具"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7F8;" Style="{StaticResource EmbeddedIcon}" /><TextBlock Grid.Column="1" Text="SD / USB 镜像工具" FontWeight="SemiBold" /></Grid><TextBlock Text="ISO、IMG、BIN 原始写入与进度校验" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Button>
            </UniformGrid>

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,0,4,8" Margin="4,22,4,10"><TextBlock Text="数据与调试辅助" FontWeight="SemiBold" /></Border>
            <UniformGrid Columns="3">
                <Button Tag="Checksum" Click="OpenTool_Click" Style="{StaticResource EmbeddedCard}" AutomationProperties.Name="CRC / 校验工具"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE9D5;" Style="{StaticResource EmbeddedIcon}" /><TextBlock Grid.Column="1" Text="CRC / 校验工具" FontWeight="SemiBold" /></Grid><TextBlock Text="报文、固件与文件指纹" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Button>
                <Button Tag="Codec" Click="OpenTool_Click" Style="{StaticResource EmbeddedCard}" AutomationProperties.Name="HEX / 编解码工具"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE8AB;" Style="{StaticResource EmbeddedIcon}" /><TextBlock Grid.Column="1" Text="HEX / 编解码工具" FontWeight="SemiBold" /></Grid><TextBlock Text="HEX、Base64 与文本互转" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Button>
                <Button Tag="Logs" Click="OpenTool_Click" Style="{StaticResource EmbeddedCard}" AutomationProperties.Name="日志与回放"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE9D9;" Style="{StaticResource EmbeddedIcon}" /><TextBlock Grid.Column="1" Text="日志与回放" FontWeight="SemiBold" /></Grid><TextBlock Text="保留原始字节、时间戳和调试过程" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel></Button>
            </UniformGrid>
        </StackPanel></ScrollViewer>
    </Grid>
</UserControl>
