<UserControl x:Class="EmbeddedDebugger.App.Controls.NetworkStatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" VerticalAlignment="Center" ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="30000">
    <UserControl.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="自动（TCPing / ICMP）" Command="{Binding UseAutomaticCommand}" IsChecked="{Binding IsAutomatic, Mode=OneWay}" />
            <MenuItem Header="ICMP Ping" Command="{Binding UseIcmpCommand}" IsChecked="{Binding IsIcmp, Mode=OneWay}" />
            <Separator />
            <MenuItem Header="关闭网络探测" Command="{Binding DisableCommand}" IsChecked="{Binding IsDisabled, Mode=OneWay}" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <StackPanel Orientation="Horizontal" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="14" Margin="0,0,7,0">
            <Rectangle Width="3" Height="4" Fill="{Binding Tone}" Opacity="{Binding Bar1Opacity}" VerticalAlignment="Bottom" />
            <Rectangle Width="3" Height="7" Margin="2,0,0,0" Fill="{Binding Tone}" Opacity="{Binding Bar2Opacity}" VerticalAlignment="Bottom" />
            <Rectangle Width="3" Height="10" Margin="2,0,0,0" Fill="{Binding Tone}" Opacity="{Binding Bar3Opacity}" VerticalAlignment="Bottom" />
            <Rectangle Width="3" Height="14" Margin="2,0,0,0" Fill="{Binding Tone}" Opacity="{Binding Bar4Opacity}" VerticalAlignment="Bottom" />
        </StackPanel>
        <TextBlock Text="{Binding Label}" Foreground="{Binding Tone}" FontSize="11" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
