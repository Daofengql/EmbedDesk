<UserControl x:Class="EmbeddedDebugger.App.Controls.SerialTabWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EmbeddedDebugger.App.Controls">
    <UserControl.Resources>
        <local:ActiveTabBrushConverter x:Key="ActiveTabBrush" />
        <local:ActiveTabVisibilityConverter x:Key="ActiveTabVisibility" />
        <local:ConnectionStateBrushConverter x:Key="StateBrush" />
    </UserControl.Resources>
    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="22,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel><TextBlock Text="串口调试" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="多标签串口收发、Shell 和自动发送" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,4">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="NewSerialTab" Style="{StaticResource IconButton}" Command="{Binding AddSerialSessionCommand}" ToolTip="新建串口标签" Margin="6,0,0,0"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" /></Button>
                <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Tabs_MouseWheel">
                    <ItemsControl x:Name="TabStrip" ItemsSource="{Binding SerialSessions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Height="34" Margin="0,0,4,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" ToolTip="{Binding Detail}"
                                    PreviewMouseLeftButtonDown="Tab_MouseDown" PreviewMouseMove="Tab_MouseMove" AllowDrop="True" DragOver="Tab_DragOver" Drop="Tab_Drop">
                                <Border.Background><MultiBinding Converter="{StaticResource ActiveTabBrush}"><Binding /><Binding Path="DataContext.SelectedSerialSession" RelativeSource="{RelativeSource AncestorType=local:SerialTabWorkspace}" /></MultiBinding></Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <Grid>
                                    <Button x:Name="TabLabel" PreviewMouseDoubleClick="RenameTab_DoubleClick" Click="SelectTab_Click" Padding="10,3" Background="Transparent" BorderThickness="0" MinWidth="96">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding Status, Converter={StaticResource StateBrush}}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Title}" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <TextBox x:Name="TitleEditor" Visibility="Collapsed" MinWidth="120" MaxWidth="180" Height="28" MinHeight="0" Margin="3,1" Padding="6,2" MaxLength="64"
                                             ToolTip="Enter 保存 · Esc 取消 · 留空恢复串口名" PreviewKeyDown="TitleEditor_KeyDown" LostKeyboardFocus="TitleEditor_LostFocus" />
                                    </Grid>
                                    <Button Width="26" Height="26" Style="{StaticResource IconButton}" Click="CloseTab_Click" ToolTip="关闭标签" Margin="0,0,3,0"><TextBlock Text="×" FontSize="17" Foreground="{StaticResource MutedBrush}" /></Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid x:Name="SessionHost" Grid.Row="2" />
    </Grid>
</UserControl>
