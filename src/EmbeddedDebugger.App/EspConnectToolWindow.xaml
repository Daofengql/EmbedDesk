<Window x:Class="EmbeddedDebugger.App.EspConnectToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESPConnect · ESP32 工具" Icon="Assets/embedded-debugger.ico"
        Width="1120" Height="780" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="ESPConnect" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="  ·  ESP32 / ESP8266" Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,2" /></StackPanel>
                <TextBlock Text="串口 ROM 连接、固件烧录和串口监视器" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="ConnectionState" Text="未连接" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="ConnectButton" Content="连接" Style="{StaticResource PrimaryButton}" Click="Connect_Click" MinWidth="92" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="串口" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" /><ComboBox x:Name="PortBox" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="ROM 波特率" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" /><ComboBox x:Name="BaudBox" IsEditable="True" /></StackPanel>
                    <Button Grid.Column="2" Content="刷新" Click="RefreshPorts_Click" VerticalAlignment="Bottom" Margin="0,0,8,0" />
                    <Button Grid.Column="3" x:Name="MonitorButton" Content="启动监视器" Click="Monitor_Click" VerticalAlignment="Bottom" IsEnabled="False" />
                    <TextBlock Grid.Column="4" x:Name="DeviceSummary" Text="选择串口后连接到下载模式。" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,14,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TabControl Grid.Row="1" x:Name="WorkTabs" Margin="0,12,0,0">
                <TabItem Header="设备信息">
                    <Grid Margin="8,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="设备信息" FontSize="16" FontWeight="SemiBold" />
                        <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="芯片系列" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="1" x:Name="ChipFamilyText" Text="—" />
                            <TextBlock Grid.Row="1" Text="芯片 ID" Style="{StaticResource MutedText}" Margin="0,14,0,0" /><TextBlock Grid.Row="1" Grid.Column="1" x:Name="ChipIdText" Text="—" Margin="0,14,0,0" />
                            <TextBlock Grid.Row="2" Text="串口" Style="{StaticResource MutedText}" Margin="0,14,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" x:Name="PortText" Text="—" Margin="0,14,0,0" />
                            <TextBlock Grid.Row="3" Text="说明" Style="{StaticResource MutedText}" Margin="0,14,0,0" /><TextBlock Grid.Row="3" Grid.Column="1" Text="ROM 协议直接在应用内实现，不需要旁边放置 esptool.exe 或其他外部程序。" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="固件烧录">
                    <Grid Margin="8,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="FirmwarePathBox" IsReadOnly="True" VerticalContentAlignment="Center" /><Button Grid.Column="1" Content="选择 .bin" Click="SelectFirmware_Click" Margin="10,0,0,0" /></Grid>
                        <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="烧录地址" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" /><TextBox x:Name="AddressBox" Text="0x10000" /></StackPanel><TextBlock Grid.Column="1" Text="FLASH_BEGIN 会擦除目标区域" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="0,0,0,7" TextWrapping="Wrap" /></Grid>
                        <TextBox Grid.Row="2" x:Name="FlashLogBox" Margin="0,14,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><ProgressBar x:Name="FlashProgress" Height="8" Minimum="0" Maximum="100" /><TextBlock x:Name="FlashStatus" Text="请先连接 ESP 并选择固件。" Style="{StaticResource MutedText}" Margin="0,8,0,0" /></StackPanel><Button Grid.Column="1" x:Name="FlashButton" Content="擦除并烧录" Style="{StaticResource PrimaryButton}" Click="Flash_Click" IsEnabled="False" Margin="14,0,0,0" /></Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="串口监视器">
                    <Grid Margin="8,16"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBox x:Name="MonitorBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Background="#141A20" />
                        <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="MonitorInput" Text="" /><Button Grid.Column="1" Content="发送" Click="SendMonitor_Click" Margin="10,0,0,0" IsEnabled="False" x:Name="SendMonitorButton" /><Button Grid.Column="2" Content="清空" Click="ClearMonitor_Click" Margin="8,0,0,0" /></Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="分区 / 文件系统">
                    <StackPanel Margin="8,16"><TextBlock Text="分区和文件系统" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="后续可在此加入分区表读取、SPIFFS、LittleFS、FATFS 浏览和 NVS 检查。当前先保留与 ESPConnect 一致的工作区入口，避免把文件系统写入误当作普通固件写入。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0" /><Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,18,0,0"><TextBlock Text="提示：固件烧录已经支持地址、擦除、进度和 ROM 响应校验；文件系统工具将在分区探测完成后启用。" TextWrapping="Wrap" /></Border></StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="StatusText" Text="ESPConnect 工作区已就绪。" Style="{StaticResource MutedText}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
