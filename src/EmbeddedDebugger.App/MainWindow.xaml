<Window x:Class="EmbeddedDebugger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EmbeddedDebugger.App.Controls"
        Title="Embedded Debugger"
        Icon="Assets/embedded-debugger.ico"
        Width="1340"
        Height="940"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources><controls:InverseBooleanVisibilityConverter x:Key="FullscreenChromeVisibility" /></Window.Resources>
    <Grid x:Name="ApplicationSurface" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="22,12,22,0" Visibility="{Binding RemoteDebug.IsTerminalFullscreen, Converter={StaticResource FullscreenChromeVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="Assets/embedded-debugger.ico" Width="26" Height="26" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="Embedded Debugger" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OpenLogs_Click" ToolTip="运行日志"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" /></Button>
        </Grid>

        <TabControl Grid.Row="1">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid Background="{TemplateBinding Background}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Visibility="{Binding RemoteDebug.IsTerminalFullscreen, Converter={StaticResource FullscreenChromeVisibility}}"><TabPanel IsItemsHost="True" /></Border>
                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
            </Grid></ControlTemplate></TabControl.Template>
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE958;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="串口调试" /></StackPanel></TabItem.Header>
                <controls:SerialTabWorkspace />
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="远程调试" /></StackPanel></TabItem.Header>
                <controls:RemoteDebugWorkspace x:Name="RemoteArea" DataContext="{Binding RemoteDebug}" />
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="网络调试" /></StackPanel></TabItem.Header>
                <controls:NetworkWorkspace />
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Visibility="{Binding RemoteDebug.IsTerminalFullscreen, Converter={StaticResource FullscreenChromeVisibility}}" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,7">
            <TextBlock Text="{Binding ActivityStatus}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
