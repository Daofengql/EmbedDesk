<Window x:Class="EmbeddedDebugger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EmbeddedDebugger.App.Controls"
        Title="Embedded Debugger"
        Icon="Assets/embedded-debugger.ico"
        Width="1340"
        Height="880"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources><controls:InverseBooleanVisibilityConverter x:Key="FullscreenChromeVisibility" /></Window.Resources>
    <Grid x:Name="ApplicationSurface" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="22,12,22,0" Visibility="{Binding RemoteDebug.IsTerminalFullscreen, Converter={StaticResource FullscreenChromeVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="Assets/embedded-debugger.ico" Width="26" Height="26" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="Embedded Debugger" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OpenLogs_Click" ToolTip="运行日志"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" /></Button>
        </Grid>

        <TabControl Grid.Row="1">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid Background="{TemplateBinding Background}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Visibility="{Binding RemoteDebug.IsTerminalFullscreen, Converter={StaticResource FullscreenChromeVisibility}}"><TabPanel IsItemsHost="True" /></Border>
                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
            </Grid></ControlTemplate></TabControl.Template>
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE958;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="串口调试" /></StackPanel></TabItem.Header>
                <controls:SerialWorkspace />
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="远程调试" /></StackPanel></TabItem.Header>
                <controls:RemoteDebugWorkspace x:Name="RemoteArea" DataContext="{Binding RemoteDebug}" />
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource Icon}" Margin="0,0,7,0" /><TextBlock Text="网络调试" /></StackPanel></TabItem.Header>
                <TabControl Margin="0,10,0,0">
                    <TabItem Header="会话配置">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Padding="14" Margin="0,0,0,12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="协议" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding NetworkProtocol}" />
                                    <TextBlock Grid.Column="2" Text="模式" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding NetworkMode}" />
                                    <TextBlock Grid.Column="4" Text="本地端口" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="5" Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="本地地址" Margin="0,8,0,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LocalHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,8,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="远端地址" Margin="12,8,0,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0">
                                        <CheckBox Content="自动重连" IsChecked="{Binding AutoReconnect}" Margin="0,0,18,0" />
                                        <CheckBox Content="HTTP 诊断" IsChecked="{Binding TreatAsHttp}" Margin="0,0,18,0" />
                                        <CheckBox Content="定时发送" IsChecked="{Binding ScheduledSendEnabled}" Margin="0,0,8,0" />
                                        <TextBox Width="90" Text="{Binding ScheduleIntervalMs, UpdateSourceTrigger=PropertyChanged}" ToolTip="间隔毫秒" />
                                        <TextBox Width="180" Text="{Binding ScheduledPayload, UpdateSourceTrigger=PropertyChanged}" ToolTip="定时发送内容" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6" Grid.RowSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="新建并启动" Command="{Binding AddNetworkSessionCommand}" Style="{StaticResource PrimaryButton}" />
                                        <Button Content="移除会话" Command="{Binding RemoveSelectedNetworkCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="70" />
                                    <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="90" />
                                    <DataGridTextColumn Header="端点" Binding="{Binding Endpoint}" Width="190" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110" />
                                    <DataGridTextColumn Header="最近报文" Binding="{Binding LastMessage}" Width="*" />
                                    <DataGridCheckBoxColumn Header="HTTP" Binding="{Binding TreatAsHttp}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="收发终端">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="80" />
                                    <DataGridTextColumn Header="端点" Binding="{Binding Endpoint}" Width="220" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="120" />
                                    <DataGridTextColumn Header="最近报文" Binding="{Binding LastMessage}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="1" Padding="12" Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="发送" Command="{Binding SendSelectedNetworkCommand}" Style="{StaticResource PrimaryButton}" />
                                    <TextBox Text="{Binding NetworkSendText, UpdateSourceTrigger=PropertyChanged}" ToolTip="发送给选中会话" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="HTTP 诊断">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="选择一个启用 HTTP 诊断的网络会话查看报文详情。" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                            <Border Grid.Row="1" Padding="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding SelectedSession.HttpStartLine}" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="1" Text="{Binding SelectedSession.HttpHeadersText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

        </TabControl>

        <Border Grid.Row="2" Visibility="{Binding RemoteDebug.IsTerminalFullscreen, Converter={StaticResource FullscreenChromeVisibility}}" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,7">
            <TextBlock Text="{Binding ActivityStatus}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
