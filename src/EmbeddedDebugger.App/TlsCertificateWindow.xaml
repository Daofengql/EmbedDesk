<Window x:Class="EmbeddedDebugger.App.TlsCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLS 证书检查" Icon="Assets/embedded-debugger.ico" Width="960" Height="720" MinWidth="800" MinHeight="580" WindowStartupLocation="CenterOwner">
    <Window.Resources><Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,0,5" /></Style></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="TLS 证书检查" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="检查 HTTPS、MQTTS 等直接 TLS 服务的证书与握手。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="StartButton" Content="检查" Style="{StaticResource PrimaryButton}" Click="Start_Click" /><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="8,0,0,0" /><Button x:Name="CopyButton" Content="复制结果" Click="Copy_Click" IsEnabled="False" Margin="8,0,0,0" /></StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" x:Name="ParametersPanel" Margin="0,16,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="连接主机 / IP 地址" Style="{StaticResource Label}" /><TextBox x:Name="HostBox" Text="example.com" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="端口" Style="{StaticResource Label}" /><TextBox x:Name="PortBox" Text="443" /></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="SNI / 校验名称 · 留空使用连接主机" Style="{StaticResource Label}" /><TextBox x:Name="SniBox" ToolTip="连接 IP 时可填写对应域名，同时用于 SNI 和证书名称校验。" /></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="总超时 / ms" Style="{StaticResource Label}" /><TextBox x:Name="TimeoutBox" Text="10000" /></StackPanel>
            </Grid>
            <CheckBox x:Name="RevocationBox" Content="检查证书吊销状态（需要联网，可能增加等待时间）" IsChecked="False" Margin="0,10,0,0" />
        </StackPanel>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel><TextBlock x:Name="TrustText" Text="等待检查" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="SummaryText" Text="将显示有效期、名称校验、证书链、SAN 与 SHA-256 指纹。" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" /></StackPanel>
        </Border>
        <TabControl Grid.Row="3">
            <TabItem Header="检查结果"><TextBox x:Name="DetailsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" /></TabItem>
            <TabItem Header="证书 PEM"><TextBox x:Name="PemBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" /></TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="检查模式会展示无效证书并标明原因；不发送登录凭据或业务数据。不支持 STARTTLS。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
    </Grid>
</Window>
