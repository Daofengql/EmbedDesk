<Window x:Class="EmbeddedDebugger.App.TlsCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="证书与密码工具" Icon="Assets/embedded-debugger.ico" Width="1120" Height="820" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
        <Style x:Key="CodeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="FontSize" Value="12" /><Setter Property="AcceptsReturn" Value="True" /><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="VerticalContentAlignment" Value="Top" /><Setter Property="VerticalScrollBarVisibility" Value="Auto" /><Setter Property="HorizontalScrollBarVisibility" Value="Auto" /></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="证书与密码工具" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="TLS 诊断、X.509 证书与 CSR、PEM/DER、RSA / ECDSA / SM2、SM3 / SM4。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
        <TabControl Grid.Row="1" Margin="0,16,0,0">
            <TabItem Header="TLS 诊断">
                <Grid Margin="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="StartButton" Content="检查" Style="{StaticResource PrimaryButton}" Click="Start_Click" /><Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="8,0,0,0" /><Button x:Name="CopyButton" Content="复制结果" Click="Copy_Click" IsEnabled="False" Margin="8,0,0,0" /></StackPanel>
                    <StackPanel Grid.Row="1" x:Name="ParametersPanel" Margin="0,14,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="连接主机 / IP 地址" Style="{StaticResource Label}" /><TextBox x:Name="HostBox" Text="example.com" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="端口" Style="{StaticResource Label}" /><TextBox x:Name="PortBox" Text="443" /></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="SNI / 校验名称 · 留空使用连接主机" Style="{StaticResource Label}" /><TextBox x:Name="SniBox" ToolTip="连接 IP 时可填写对应域名，同时用于 SNI 和证书名称校验。" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="总超时 / ms" Style="{StaticResource Label}" /><TextBox x:Name="TimeoutBox" Text="10000" /></StackPanel></Grid><CheckBox x:Name="RevocationBox" Content="检查证书吊销状态（需要联网，可能增加等待时间）" IsChecked="False" Margin="0,10,0,0" /></StackPanel>
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10"><StackPanel><TextBlock x:Name="TrustText" Text="等待检查" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="SummaryText" Text="将显示有效期、名称校验、证书链、SAN 与 SHA-256 指纹。" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" /></StackPanel></Border>
                    <TabControl Grid.Row="3"><TabItem Header="检查结果"><TextBox x:Name="DetailsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" /></TabItem><TabItem Header="证书 PEM"><TextBox x:Name="PemBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" /></TabItem></TabControl>
                    <TextBlock x:Name="TlsStatusText" Grid.Row="4" Text="检查模式会展示无效证书并标明原因；不发送登录凭据或业务数据。不支持 STARTTLS。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </Grid>
            </TabItem>
            <TabItem Header="生成证书 / CSR">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="生成密钥、CSR 或自签名证书" Style="{StaticResource SectionTitle}" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="算法" Style="{StaticResource Label}" /><ComboBox x:Name="AlgorithmBox" SelectedIndex="0"><ComboBoxItem Tag="Rsa2048">RSA-2048 / SHA-256</ComboBoxItem><ComboBoxItem Tag="EcdsaP256">ECDSA P-256 / SHA-256</ComboBoxItem><ComboBoxItem Tag="Sm2">SM2 / SM3（国密）</ComboBoxItem></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="主题（Subject）" Style="{StaticResource Label}" /><TextBox x:Name="SubjectBox" Text="CN=localhost" /></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="SAN（逗号分隔域名或 IP）" Style="{StaticResource Label}" /><TextBox x:Name="SanBox" Text="localhost" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="有效期 / 天" Style="{StaticResource Label}" /><TextBox x:Name="ValidityBox" Text="365" /></StackPanel></Grid><Grid Grid.Row="2" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><CheckBox x:Name="CaBox" Content="CA 证书" Margin="0,0,18,0" /><CheckBox x:Name="ServerBox" Content="服务器认证" IsChecked="True" Margin="0,0,18,0" /><CheckBox x:Name="ClientBox" Content="客户端认证" IsChecked="True" Margin="0,0,18,0" /><StackPanel Grid.Column="3"><TextBlock Text="PFX 密码（可选，仅标准算法）" Style="{StaticResource Label}" /><PasswordBox x:Name="PfxPasswordBox" /></StackPanel><StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="生成自签名证书" Style="{StaticResource PrimaryButton}" Click="GenerateCertificate_Click" /><Button Content="生成 CSR" Margin="8,0,0,0" Click="GenerateCsr_Click" /></StackPanel></Grid><TabControl Grid.Row="3" MinHeight="340"><TabItem Header="证书 / CSR"><TextBox x:Name="CertificateOutputBox" Style="{StaticResource CodeBox}" IsReadOnly="True" /></TabItem><TabItem Header="私钥 PEM"><TextBox x:Name="PrivateKeyOutputBox" Style="{StaticResource CodeBox}" IsReadOnly="True" /></TabItem><TabItem Header="公钥 PEM"><TextBox x:Name="PublicKeyOutputBox" Style="{StaticResource CodeBox}" IsReadOnly="True" /></TabItem><TabItem Header="PFX Base64"><TextBox x:Name="PfxOutputBox" Style="{StaticResource CodeBox}" IsReadOnly="True" /></TabItem></TabControl></Grid></ScrollViewer>
            </TabItem>
            <TabItem Header="CA 签发">
                <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="使用 RSA / ECDSA CA 私钥签发 CSR" Style="{StaticResource SectionTitle}" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="CA 证书 PEM、DER 路径或 Base64" Style="{StaticResource Label}" /><TextBox x:Name="IssuerCertificateBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="CA 私钥 PEM 或文件路径" Style="{StaticResource Label}" /><TextBox x:Name="IssuerPrivateKeyBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="有效期 / 天" Style="{StaticResource Label}" /><TextBox x:Name="IssueValidityBox" Text="365" /></StackPanel></Grid><Grid Grid.Row="2" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="CSR PEM、DER 路径或 Base64" Style="{StaticResource Label}" /><TextBox x:Name="RequestBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="签发证书" Style="{StaticResource PrimaryButton}" Click="IssueCertificate_Click" /><Button Content="复制结果" Margin="8,0,0,0" Click="CopyIssued_Click" /></StackPanel></Grid><TextBox Grid.Row="3" x:Name="IssuedCertificateBox" Style="{StaticResource CodeBox}" IsReadOnly="True" /><TextBlock Grid.Row="4" x:Name="IssueStatusText" Text="签发操作只支持标准 RSA / ECDSA CA；SM2 CA 证书可生成和检查，SM2 链签发将在后续按实际平台能力扩展。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" /></Grid>
            </TabItem>
            <TabItem Header="解析 / 国密">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="证书解析" Style="{StaticResource SectionTitle}" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="InspectInputBox" AcceptsReturn="True" Height="74" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="粘贴 PEM、Base64，或填写 DER/证书文件路径。" /><StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom"><Button Content="解析证书" Style="{StaticResource PrimaryButton}" Click="InspectCertificate_Click" /><Button Content="复制 PEM" Margin="0,8,0,0" Click="CopyInspected_Click" /></StackPanel></Grid><TextBox Grid.Row="2" x:Name="InspectOutputBox" Style="{StaticResource CodeBox}" IsReadOnly="True" Height="190" Margin="0,10,0,16" TextWrapping="Wrap" /><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><GroupBox Header="SM3 摘要" Margin="0,0,8,0"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBox x:Name="Sm3InputBox" AcceptsReturn="True" Height="86" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /><Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="计算 UTF-8 SM3" Click="Sm3_Click" /><TextBox Grid.Column="1" x:Name="Sm3OutputBox" Margin="8,0,0,0" IsReadOnly="True" /></Grid></Grid></GroupBox><GroupBox Grid.Column="1" Header="SM4-CBC（PKCS#7）" Margin="8,0,0,0"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBox x:Name="Sm4InputBox" ToolTip="输入十六进制明文或密文" /><TextBox Grid.Row="1" x:Name="Sm4KeyBox" Margin="0,6,0,0" ToolTip="32 个十六进制字符（16 字节）" /><TextBox Grid.Row="2" x:Name="Sm4IvBox" Margin="0,6,0,0" ToolTip="32 个十六进制字符（16 字节）" /><StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="加密" Click="Sm4Encrypt_Click" /><Button Content="解密" Margin="8,0,0,0" Click="Sm4Decrypt_Click" /></StackPanel><TextBox Grid.Row="4" x:Name="Sm4OutputBox" Margin="0,8,0,0" IsReadOnly="True" /></Grid></GroupBox></Grid><TextBlock Grid.Row="4" Text="提示：SM2/SM3/SM4 由 BouncyCastle 实现；Windows .NET 的 SslStream 不会因此自动获得国密 TLS 套件支持。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" /></Grid></ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="私钥仅在本窗口输出，默认不会写入文件或日志；保存需显式点击保存对话框。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
    </Grid>
</Window>
